---
// En servidor: comprueba que la cuenta esté aprobada antes de dejar comprar.
export const prerender = false;
import Base from '../layouts/Base.astro';
import { supabaseAdmin } from '../lib/supabase';
import { ENVIO_BASE, ENVIO_GRATIS_DESDE } from '../lib/tienda';

const usuario = Astro.locals.user;
let aprobado = false;
let direccionPerfil = '';
if (usuario) {
  const { data: perfil } = await supabaseAdmin.from('perfiles').select('estado, direccion').eq('id', usuario.id).single();
  aprobado = perfil?.estado === 'aprobado';
  direccionPerfil = perfil?.direccion ?? '';
}
---
<Base title="Carrito | AVCI Smart Homes" description="Tu carrito en AVCI Smart Homes.">
  <section class="carrito">
    <h1>Tu carrito</h1>

    <div id="carrito-vacio" class="vacio" hidden>
      <p>Tu carrito está vacío.</p>
      <a href="/productos" class="boton">Ver productos</a>
    </div>

    <div id="carrito-lleno" hidden>
      <ul id="lineas" class="lineas"></ul>

      {aprobado ? (
        <div class="pie">
          <form id="form-codigo" class="codigo">
            <label for="codigo">Código de descuento</label>
            <div class="codigo-fila">
              <input id="codigo" name="codigo" autocomplete="off" maxlength="40" placeholder="Escribe tu código" />
              <button type="submit" class="boton boton--borde">Aplicar</button>
            </div>
            <p id="aviso-codigo" class="aviso" hidden></p>
          </form>

          <div class="resumen">
            <p>Subtotal <span id="subtotal"></span></p>
            <p id="fila-descuento" class="descuento" hidden>Descuento <span id="codigo-aplicado"></span> <span id="descuento"></span></p>
            <p>Envío <span id="envio"></span></p>
            <p class="total">Total <strong id="total"></strong></p>
            <p class="nota">IVA (21 %) incluido.</p>
            <p id="falta-envio" class="nota envio-gratis"></p>
          </div>

          <form id="form-pedido" class="envio">
            <h2>Datos de envío</h2>
            <label>Dirección de envío
              <textarea name="direccion" rows="3" required minlength="10" maxlength="400">{direccionPerfil}</textarea>
            </label>
            <label>Teléfono de contacto
              <input name="telefono" type="tel" required maxlength="30" autocomplete="tel" />
            </label>
            <label>Notas para el pedido (opcional)
              <textarea name="notas" rows="2" maxlength="1000"></textarea>
            </label>

            <div class="pago">
              <h2>Forma de pago: transferencia bancaria</h2>
              <p>Al confirmar el pedido te mostraremos (y te enviaremos por email) el IBAN y el concepto para la transferencia. Prepararemos el envío en cuanto recibamos el pago.</p>
            </div>

            <label class="check">
              <input type="checkbox" name="condiciones" required />
              <span>He leído y acepto las <a href="/condiciones-generales-compra" target="_blank">condiciones generales de compra</a>.</span>
            </label>

            <button id="confirmar" type="submit" class="boton">Confirmar pedido</button>
            <p id="error" class="error" hidden></p>
          </form>
        </div>
      ) : (
        <div class="resumen">
          <p class="total">Total <strong id="total"></strong></p>
          <p class="nota">IVA (21 %) incluido. Envío {ENVIO_BASE} € + IVA, gratis a partir de {ENVIO_GRATIS_DESDE.toLocaleString('es-ES')} € + IVA.</p>
          <a href="/cuenta" class="boton boton--gris">
            {usuario ? 'Tu cuenta está pendiente de aprobación' : 'Inicia sesión para comprar'}
          </a>
        </div>
      )}
    </div>
  </section>

  <script>
    import { ENVIO_GRATIS_DESDE, conIva } from '../lib/tienda';
    type Linea = { id: string; productoId: string; varianteId: string | null; nombre: string; precio: number; cantidad: number };

    const euros = (n: number) => n.toLocaleString('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 });
    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const leer = (): Linea[] => {
      try { return JSON.parse(localStorage.getItem('carrito') || '[]'); } catch { return []; }
    };
    const escapar = (t: string) => t.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    let codigo = '';
    let porcentaje: number | null = null; // descuento en % del código aplicado (para tachar precios)
    const conDescuento = (precio: number) =>
      porcentaje ? Math.round(precio * (1 - porcentaje / 100) * 100) / 100 : precio;
    const importeHtml = (importe: number, rebajado: number) =>
      rebajado < importe
        ? `<s class="antes">${euros(importe)}</s> <span class="rebajado">${euros(rebajado)}</span>`
        : euros(importe);

    function guardar(carrito: Linea[]) {
      localStorage.setItem('carrito', JSON.stringify(carrito));
      window.dispatchEvent(new Event('carrito-cambiado'));
      pintar();
    }

    function pintar() {
      const carrito = leer();
      $('carrito-vacio')!.hidden = carrito.length > 0;
      $('carrito-lleno')!.hidden = carrito.length === 0;
      if (!carrito.length) return;
      pintarLineas(carrito);
      // Total provisional al instante; el servidor lo confirma justo después.
      $('total')!.textContent = euros(carrito.reduce((s, l) => s + l.precio * l.cantidad, 0));
      recalcular();
    }

    function pintarLineas(carrito: Linea[]) {
      $('lineas')!.innerHTML = carrito.map((l, i) => `
        <li class="linea">
          <span class="nombre">${escapar(l.nombre)}</span>
          <span class="unidad">${importeHtml(l.precio, conDescuento(l.precio))}</span>
          <input type="number" min="1" max="9999" value="${l.cantidad}" data-i="${i}" aria-label="Cantidad" />
          <span class="importe">${importeHtml(l.precio * l.cantidad, conDescuento(l.precio) * l.cantidad)}</span>
          <button type="button" class="quitar" data-quitar="${i}" aria-label="Quitar">×</button>
        </li>`).join('');
    }

    // El resumen (precios, descuento y total) lo calcula siempre el servidor.
    async function recalcular() {
      if (!$('subtotal')) return; // cuenta no aprobada: solo total provisional
      const res = await fetch('/api/pedido', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accion: 'calcular', items: leer(), codigo }),
      }).catch(() => null);
      const datos = await res?.json().catch(() => null);
      const aviso = $('aviso-codigo')!;
      if (!res?.ok || !datos) {
        aviso.textContent = datos?.error || 'No se pudo calcular el pedido.';
        aviso.hidden = false;
        return;
      }
      // Precios del servidor (por si han cambiado) y descuento en % para tacharlos.
      const carrito = leer();
      for (const l of carrito) {
        const s = datos.lineas.find((x: any) => x.productoId === l.productoId && (x.varianteId ?? null) === (l.varianteId ?? null));
        if (s) l.precio = s.precio;
      }
      localStorage.setItem('carrito', JSON.stringify(carrito));
      porcentaje = datos.porcentaje ?? null;
      pintarLineas(carrito);
      $('subtotal')!.textContent = euros(datos.subtotal);
      $('total')!.textContent = euros(datos.total);
      $('fila-descuento')!.hidden = !datos.descuento;
      $('codigo-aplicado')!.textContent = datos.codigo ? `(${datos.codigo})` : '';
      $('descuento')!.textContent = `-${euros(datos.descuento)}`;
      $('envio')!.textContent = datos.envio ? euros(datos.envio) : 'Gratis';
      const productos = datos.subtotal - datos.descuento;
      $('falta-envio')!.textContent = datos.envio
        ? `Te faltan ${euros(conIva(ENVIO_GRATIS_DESDE) - productos)} (IVA incl.) para el envío gratis (pedidos desde ${ENVIO_GRATIS_DESDE.toLocaleString('es-ES')} € + IVA).`
        : '¡Tienes el envío gratis!';
      aviso.hidden = !datos.avisoCodigo && !datos.codigo;
      aviso.textContent = datos.avisoCodigo || (datos.codigo
        ? datos.codigoEsDeCuenta
          ? `Descuento de tu cuenta aplicado: ${datos.codigo}${datos.porcentaje ? ` (-${datos.porcentaje.toLocaleString('es-ES')} %)` : ''}.`
          : `Código ${datos.codigo} aplicado.`
        : '');
      aviso.classList.toggle('aviso--ok', !datos.avisoCodigo);
      if (datos.avisoCodigo) codigo = '';
    }

    $('lineas')!.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.dataset.i === undefined) return;
      const carrito = leer();
      carrito[Number(input.dataset.i)].cantidad = Math.min(9999, Math.max(1, Math.floor(Number(input.value) || 1)));
      guardar(carrito);
    });
    $('lineas')!.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-quitar]');
      if (!boton) return;
      const carrito = leer();
      carrito.splice(Number(boton.dataset.quitar), 1);
      guardar(carrito);
    });

    $('form-codigo')?.addEventListener('submit', (e) => {
      e.preventDefault();
      codigo = $<HTMLInputElement>('codigo')!.value.trim();
      recalcular();
    });

    $<HTMLFormElement>('form-pedido')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const boton = $<HTMLButtonElement>('confirmar')!;
      const error = $('error')!;
      const datos = new FormData(form);
      error.hidden = true;
      boton.disabled = true;
      boton.textContent = 'Enviando pedido…';
      try {
        const res = await fetch('/api/pedido', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            accion: 'confirmar',
            items: leer(),
            codigo,
            direccion: datos.get('direccion'),
            telefono: datos.get('telefono'),
            notas: datos.get('notas'),
          }),
        });
        const r = await res.json();
        if (r.ok) {
          localStorage.removeItem('carrito');
          window.location.href = `/pedido-confirmado?id=${encodeURIComponent(r.id)}`;
          return;
        }
        error.textContent = r.error || 'No se pudo enviar el pedido.';
      } catch {
        error.textContent = 'No se pudo enviar el pedido. Inténtalo de nuevo.';
      }
      error.hidden = false;
      boton.disabled = false;
      boton.textContent = 'Confirmar pedido';
    });

    pintar();
  </script>

  <style>
    .carrito { max-width: 900px; margin: 0 auto; padding: 2rem 16px 4rem; }
    h1 { font-size: 2rem; margin: 0 0 1.5rem; }
    h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
    .lineas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
    :global(.linea) {
      display: grid;
      grid-template-columns: 1fr auto 4.5rem 6.5rem 2rem;
      gap: 0.75rem;
      align-items: center;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--color-border);
    }
    :global(.linea .unidad) { color: var(--color-muted); font-size: 0.9rem; }
    :global(.linea .importe) { text-align: right; font-weight: 700; }
    :global(.linea input) { width: 100%; padding: 0.35rem; border: 1px solid var(--color-border); border-radius: 6px; }
    :global(.linea .antes) { color: var(--color-muted); font-weight: 400; font-size: 0.85em; }
    :global(.linea .rebajado) { color: #d0021b; font-weight: 700; }
    :global(.linea .quitar) { border: none; background: none; font-size: 1.4rem; cursor: pointer; color: var(--color-muted); }

    .pie { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2.5rem; margin-top: 1.5rem; }
    .codigo label { font-weight: 700; font-size: 0.9rem; }
    .codigo-fila { display: flex; gap: 0.5rem; margin-top: 0.4rem; }
    .codigo-fila input { flex: 1; min-width: 0; text-transform: uppercase; }
    .aviso { margin: 0.5rem 0 0; font-size: 0.9rem; color: #b00020; }
    .aviso--ok { color: #1b7a3a; }

    .resumen { text-align: right; }
    .resumen p { margin: 0.2rem 0; }
    .resumen .descuento { color: #d0021b; }
    .envio-gratis { color: #1b7a3a; font-weight: 600; }
    .total { font-size: 1.4rem; margin-top: 0.5rem !important; }
    .nota { color: var(--color-muted); font-size: 0.9rem; }

    .envio { grid-column: 1 / -1; border-top: 1px solid var(--color-border); padding-top: 1.5rem; display: grid; gap: 1rem; max-width: 560px; }
    .envio label { display: grid; gap: 0.35rem; font-weight: 600; font-size: 0.9rem; }
    input, textarea { font: inherit; padding: 0.55rem 0.7rem; border: 1px solid var(--color-border); border-radius: 6px; }
    .envio .check { display: flex; gap: 0.5rem; align-items: flex-start; font-weight: 400; }
    .pago { background: #f5f5f5; border-radius: 8px; padding: 1rem 1.25rem; }
    .pago p { margin: 0; color: var(--color-muted); font-size: 0.92rem; }

    .boton {
      display: inline-block;
      background: var(--color-primary);
      color: var(--color-primary-text);
      border: 1px solid var(--color-primary);
      padding: 0.8rem 2rem;
      border-radius: 999px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      justify-self: start;
    }
    .resumen .boton { margin-top: 1.25rem; }
    .boton:disabled { opacity: 0.6; cursor: wait; }
    .boton--gris { background: var(--color-text); border-color: var(--color-text); }
    .boton--borde { background: transparent; color: var(--color-text); padding: 0.55rem 1.2rem; }
    .error { color: #b00020; margin: 0; }
    .vacio { text-align: center; padding: 3rem 0; }

    @media (max-width: 640px) {
      :global(.linea) { grid-template-columns: 1fr 4rem 2rem; }
      :global(.linea .nombre) { grid-column: 1 / -1; }
      :global(.linea .unidad) { display: none; }
      :global(.linea .importe) { grid-column: 1; grid-row: 2; text-align: left; }
      .pie { grid-template-columns: 1fr; }
      .resumen { text-align: left; }
    }
  </style>
</Base>
