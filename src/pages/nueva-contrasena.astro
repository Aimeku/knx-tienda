---
// Destino del enlace "Restablecer contraseña" que envía Supabase por email.
// Supabase añade un código a la URL; el cliente del navegador lo canjea por
// una sesión temporal y con ella se guarda la contraseña nueva.
export const prerender = false;
import Base from '../layouts/Base.astro';
---
<Base title="Nueva contraseña | AVCI Smart Homes" description="Crea una contraseña nueva para tu cuenta.">
  <section class="nueva">
    <div class="tarjeta">
      <h1>Nueva contraseña</h1>

      <p id="cargando" class="ayuda">Comprobando el enlace…</p>

      <div id="caducado" hidden>
        <p class="mensaje error">El enlace no es válido o ha caducado. Pide uno nuevo desde «¿Has olvidado tu contraseña?».</p>
        <a href="/cuenta" class="enviar">Volver a mi cuenta</a>
      </div>

      <form id="form-nueva" hidden>
        <p class="ayuda">Cuenta: <strong id="email-cuenta"></strong></p>
        <label>Contraseña nueva
          <input type="password" name="password" minlength="8" required autocomplete="new-password" />
        </label>
        <label>Repite la contraseña
          <input type="password" name="repetir" minlength="8" required autocomplete="new-password" />
        </label>
        <p class="nota">Mínimo 8 caracteres.</p>
        <p id="mensaje" class="mensaje" hidden></p>
        <button type="submit" class="enviar">Guardar contraseña</button>
      </form>
    </div>
  </section>

  <script>
    import { supabaseBrowser } from '../lib/supabase-browser';

    const $ = (id: string) => document.getElementById(id)!;
    const params = new URLSearchParams(window.location.search);
    const hash = new URLSearchParams(window.location.hash.slice(1));

    // getSession espera a que el cliente termine de canjear el código del enlace.
    supabaseBrowser.auth.getSession().then(({ data }) => {
      $('cargando').hidden = true;
      if (!data.session || params.get('error') || hash.get('error')) {
        $('caducado').hidden = false;
        return;
      }
      $('email-cuenta').textContent = data.session.user.email ?? '';
      $('form-nueva').hidden = false;
      // Quita el código de la barra de direcciones.
      history.replaceState(null, '', window.location.pathname);
    });

    $('form-nueva').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const boton = form.querySelector('button')!;
      const mensaje = $('mensaje');
      const password = (form.elements.namedItem('password') as HTMLInputElement).value;
      const repetir = (form.elements.namedItem('repetir') as HTMLInputElement).value;
      const error = (texto: string) => {
        mensaje.textContent = texto;
        mensaje.className = 'mensaje error';
        mensaje.hidden = false;
      };
      if (password !== repetir) return error('Las dos contraseñas no coinciden.');

      boton.disabled = true;
      boton.textContent = 'Guardando…';
      const { error: fallo } = await supabaseBrowser.auth.updateUser({ password });
      if (fallo) {
        boton.disabled = false;
        boton.textContent = 'Guardar contraseña';
        return error(/different|same/i.test(fallo.message)
          ? 'La contraseña nueva tiene que ser distinta de la anterior.'
          : /weak|short|least/i.test(fallo.message)
          ? 'La contraseña es demasiado débil: usa al menos 8 caracteres.'
          : 'No se pudo guardar la contraseña. Pide un enlace nuevo e inténtalo otra vez.');
      }
      mensaje.textContent = 'Contraseña cambiada. Te llevamos a tu cuenta…';
      mensaje.className = 'mensaje ok';
      mensaje.hidden = false;
      setTimeout(() => { window.location.href = '/cuenta'; }, 1500);
    });
  </script>

  <style>
    .nueva { max-width: 480px; margin: 0 auto; padding: 4rem 16px; }
    .tarjeta { border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem; }
    h1 { font-size: 1.6rem; margin: 0 0 1.25rem; }
    form { display: flex; flex-direction: column; gap: 1rem; }
    label { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.9rem; font-weight: 600; }
    input { font: inherit; padding: 0.7rem 0.9rem; border: 1px solid var(--color-border); border-radius: 8px; }
    input:focus { outline: none; border-color: var(--color-primary); }
    .ayuda { margin: 0 0 0.5rem; color: var(--color-muted); }
    .nota { margin: 0; font-size: 0.85rem; color: var(--color-muted); }
    .mensaje { padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.9rem; margin: 0 0 1rem; }
    .mensaje.ok { background: #eef4ff; border: 1px solid var(--color-primary); }
    .mensaje.error { background: #fdeeee; border: 1px solid #d33; color: #a00; }
    .enviar {
      display: inline-block;
      align-self: flex-start;
      background: var(--color-primary);
      color: var(--color-primary-text);
      border: none;
      padding: 0.8rem 2rem;
      border-radius: 999px;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
    }
    .enviar:disabled { opacity: 0.6; cursor: wait; }
  </style>
</Base>
