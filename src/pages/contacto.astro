---
export const prerender = true;
import Base from '../layouts/Base.astro';
---
<Base title="Contacto | AVCI Smart Homes" description="Cuéntanos tu proyecto de domótica KNX y te ayudamos a encontrar la solución adecuada.">
  <section class="contacto">
    <div class="panel-info">
      <p class="eyebrow">Domótica KNX para cualquier proyecto</p>
      <h1>Cuéntanos qué necesitas y lo hacemos posible<span class="accent-dot">.</span></h1>
      <p class="subtitle">
        Ya seas integrador, arquitecto, diseñador, propietario o promotora, en AVCI te ayudamos a
        encontrar la solución de domótica que mejor se adapta a tu proyecto. Escríbenos y te
        respondemos lo antes posible.
      </p>
      <p class="pregunta">¿Listo para empezar tu proyecto?</p>
      <a class="cta" href="#formulario-contacto">Escríbenos</a>
    </div>

    <form class="panel-form" id="formulario-contacto">
      <div class="grid-2">
        <input type="text" name="nombre" placeholder="Nombre" aria-label="Nombre" required />
        <input type="tel" name="telefono" placeholder="Teléfono" aria-label="Teléfono" required />
      </div>
      <input type="email" name="email" placeholder="Correo electrónico" aria-label="Correo electrónico" required />

      <label class="campo-label" for="tecnologia">Tipo de tecnología</label>
      <select id="tecnologia" name="tecnologia">
        <option value="cableado">Cableado (KNX)</option>
        <option value="inalambrico">Inalámbrico (IoT)</option>
        <option value="no-seguro">No estoy seguro, asesórame</option>
      </select>

      <input type="text" name="objetivo" placeholder="Objetivo de control (iluminación, clima, seguridad...)" aria-label="Objetivo de control" />

      <label class="campo-label" for="tipo-proyecto">Tipo de proyecto</label>
      <select id="tipo-proyecto" name="tipoProyecto">
        <option value="vivienda-nueva">Vivienda nueva</option>
        <option value="reforma">Reforma</option>
        <option value="negocio">Oficina / Negocio</option>
        <option value="promocion">Promoción inmobiliaria</option>
        <option value="otro">Otro</option>
      </select>

      <input type="text" name="ubicacion" placeholder="Ubicación" aria-label="Ubicación" />
      <textarea name="mensaje" placeholder="¿Necesitas decirnos algo más?" aria-label="Mensaje" rows="4"></textarea>

      <label class="privacidad">
        <input type="checkbox" name="privacidad" required />
        He leído y acepto la <a href="/privacidad">política de privacidad</a>
      </label>

      <p class="confirmacion" hidden>
        Gracias, hemos recibido tu mensaje. Nos pondremos en contacto contigo lo antes posible.
      </p>

      <button type="submit" class="enviar">
        Enviar
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 11L21 3L13 21L11 13L3 11Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      </button>
    </form>
  </section>

  <script>
    const form = document.getElementById('formulario-contacto') as HTMLFormElement | null;
    const confirmacion = form?.querySelector('.confirmacion') as HTMLElement | null;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      // TODO: conectar con el servicio de envío (email/CRM) cuando esté definido.
      if (confirmacion) confirmacion.hidden = false;
      form.reset();
    });
  </script>

  <style>
    .contacto {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      min-height: calc(100vh - 82px);
    }
    @media (max-width: 900px) {
      .contacto { grid-template-columns: 1fr; }
    }

    .panel-info {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.5rem;
      padding: 4rem 3rem;
      background: #0a0a0a;
      color: #fff;
    }
    .panel-info::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 25% 25%, rgba(255, 255, 255, 0.1), transparent 55%),
        linear-gradient(135deg, transparent 40%, rgba(255, 255, 255, 0.06) 48%, transparent 56%);
      pointer-events: none;
    }
    .panel-info > * { position: relative; z-index: 1; }

    .panel-info .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.15em;
      font-size: 0.8rem;
      color: #999;
      margin: 0;
    }
    .panel-info h1 {
      font-size: clamp(1.75rem, 4vw, 3rem);
      font-weight: 800;
      margin: 0;
      line-height: 1.15;
    }
    .accent-dot { color: #fff; }
    .panel-info .subtitle {
      color: #ccc;
      font-size: 1.05rem;
      font-weight: 300;
      line-height: 1.6;
      max-width: 480px;
      margin: 0;
    }
    .panel-info .pregunta {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 1rem 0 0;
    }
    .panel-info .cta {
      display: inline-block;
      align-self: flex-start;
      background: var(--color-primary);
      color: var(--color-primary-text);
      padding: 0.9rem 2.5rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.85rem;
    }

    .panel-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 4rem 3rem;
    }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 480px) {
      .grid-2 { grid-template-columns: 1fr; }
    }

    .panel-form input[type='text'],
    .panel-form input[type='tel'],
    .panel-form input[type='email'],
    .panel-form select,
    .panel-form textarea {
      width: 100%;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      padding: 0.9rem 1rem;
      font: inherit;
      color: var(--color-text);
      background: #fff;
    }
    .panel-form input:focus,
    .panel-form select:focus,
    .panel-form textarea:focus {
      outline: none;
      border-color: var(--color-primary);
    }
    .panel-form textarea { resize: vertical; }
    .campo-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-muted);
      margin-bottom: -0.5rem;
    }

    .privacidad {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      font-size: 0.85rem;
      color: var(--color-muted);
    }
    .privacidad input { accent-color: var(--color-primary); margin-top: 0.2rem; }
    .privacidad a { color: var(--color-text); }

    .confirmacion {
      background: #eef4ff;
      color: var(--color-text);
      border: 1px solid var(--color-primary);
      border-radius: 6px;
      padding: 0.85rem 1rem;
      font-size: 0.9rem;
      margin: 0;
    }

    .enviar {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--color-primary);
      color: var(--color-primary-text);
      border: none;
      cursor: pointer;
      padding: 0.9rem 2rem;
      border-radius: 999px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.85rem;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .enviar:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(10, 10, 10, 0.35);
    }
  </style>
</Base>
