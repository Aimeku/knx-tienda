---
// Depende de los parámetros de la URL (filtros, búsqueda, página), así que no se
// puede pregenerar en build.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { supabase, supabaseAdmin } from '../../lib/supabase';
import { COMPRAS_ACTIVAS, formatoPrecio } from '../../lib/tienda';
import { descuentoDeCuenta, conDescuento, type DescuentoCuenta } from '../../lib/pedidos';

// Los precios solo se pintan para cuentas aprobadas (comprobado en servidor).
const usuario = Astro.locals.user;
let aprobado = false;
let descuento: DescuentoCuenta | null = null;
if (COMPRAS_ACTIVAS && usuario) {
  const { data: perfil } = await supabaseAdmin.from('perfiles').select('estado, codigo_descuento').eq('id', usuario.id).single();
  aprobado = perfil?.estado === 'aprobado';
  if (aprobado) descuento = await descuentoDeCuenta(perfil?.codigo_descuento);
}
// Precio de la tarjeta: el importe sin IVA (neto), o un texto si no se puede mostrar.
const precioTarjeta = (p: { precio?: number | null; precio_oferta?: number | null }): { importe?: string; antes?: string; texto?: string } => {
  if (!COMPRAS_ACTIVAS) return { texto: 'Precio bajo consulta' };
  if (!aprobado) return { texto: 'Inicia sesión para ver precios' };
  const base = Number(p.precio_oferta ?? p.precio);
  if (!(base > 0)) return { texto: 'Precio bajo consulta' };
  // Con descuento de cuenta: el precio normal tachado y el nuevo en rojo.
  return descuento
    ? { importe: formatoPrecio(conDescuento(base, descuento.porcentaje)), antes: formatoPrecio(base) }
    : { importe: formatoPrecio(base) };
};
import { tiendaMenu, categorias as categoriasPlano, marcasBase, seccionesDe } from '../../lib/categorias';

const POR_PAGINA = 48;
const params = Astro.url.searchParams;

const categoriasSeleccionadas = params.getAll('categoria');
const marcasSeleccionadas = params.getAll('marca');
// La búsqueda va dentro de un filtro "or" de PostgREST: quitamos los caracteres
// que tienen significado especial ahí.
const busqueda = (params.get('q') ?? '').replace(/[,()*%\\]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 60);
// Por defecto, el orden preparado de la tienda (columna productos.orden).
const ORDENES = { recomendado: 'orden', nombre: 'nombre', referencia: 'sku' } as const;
const ordenParam = params.get('orden') ?? '';
const orden: keyof typeof ORDENES = Object.hasOwn(ORDENES, ordenParam) ? (ordenParam as keyof typeof ORDENES) : 'recomendado';
const pagina = Math.max(1, parseInt(params.get('pagina') ?? '1', 10) || 1);
const hayFiltrosActivos = categoriasSeleccionadas.length > 0 || marcasSeleccionadas.length > 0 || busqueda !== '';

// Traducción slug -> id de categoría (pocas filas).
const { data: categoriasDb } = await supabase.from('categorias').select('id, slug');
const idPorSlug = new Map((categoriasDb ?? []).map((c) => [c.slug, c.id]));

// Consulta de productos con los filtros de la URL aplicados.
function consultaFiltrada(campos: string, opciones?: { count: 'exact' }) {
  let consulta = supabase.from('productos').select(campos, opciones).eq('activo', true);
  if (categoriasSeleccionadas.length > 0) {
    const ids = categoriasSeleccionadas.map((slug) => idPorSlug.get(slug)).filter((id): id is string => Boolean(id));
    // Si ninguna categoría existe todavía en la base de datos, no debe salir nada.
    consulta = ids.length > 0 ? consulta.in('categoria_id', ids) : consulta.eq('id', '00000000-0000-0000-0000-000000000000');
  }
  if (marcasSeleccionadas.length > 0) {
    consulta = consulta.in('marca', marcasSeleccionadas);
  }
  if (busqueda) {
    // Cada palabra debe aparecer en el nombre o en la referencia.
    for (const palabra of busqueda.split(' ')) {
      consulta = consulta.or(`nombre.ilike.*${palabra}*,sku.ilike.*${palabra}*`);
    }
  }
  return consulta.order(ORDENES[orden]).order('sku');
}

type Producto = { id: string; nombre: string; slug: string; imagen_principal: string | null; marca: string | null; sku: string | null };
// Una casilla de la rejilla: un producto o un hueco en blanco. "inicio" marca
// el primer producto de una fila centrada de n productos (placas y teclas).
type Casilla = { p: Producto; inicio?: number } | null;
// En la rejilla, una fila centrada empieza con este marcador seguido de sus
// productos; el marcador ocupa la 4.ª casilla de la fila (no se pinta).
type Celda = string | null | { centrar: number };
// Sin precios: la clave pública de Supabase no puede leerlos. Los precios se
// piden aparte, con el cliente de servidor, solo para cuentas aprobadas.
const CAMPOS = 'id, nombre, slug, imagen_principal, marca, sku';

let casillas: Casilla[] = [];
let total = 0;
let totalPaginas = 1;

if (orden === 'recomendado' && !busqueda) {
  // Orden recomendado: los mecanismos de Vimar Linea van en filas de 4
  // (mecanismo sin tecla + blanco, cáñamo y negro). Se monta la rejilla
  // completa y se corta en páginas de 48 casillas, así ninguna fila queda
  // partida entre dos páginas.
  const { data: lista } = await consultaFiltrada('id, sku, categoria_id').range(0, 4999);
  const filas = (lista ?? []) as unknown as { id: string; sku: string | null; categoria_id: string | null }[];
  total = filas.length;
  // El soporte Eikon 21603 (de Eikon · Mecanismos) se repite al principio de
  // Eikon · Vintage y Eikon · Flat/Tondo: sirve para todos los mandos Eikon.
  const repetirAlInicio = [idPorSlug.get('vimar-knx-eikon-vintage'), idPorSlug.get('vimar-knx-eikon-flat-tondo')].filter(Boolean);
  if (filas.some((f) => f.categoria_id && repetirAlInicio.includes(f.categoria_id))) {
    const { data: soporte } = await supabase.from('productos').select('id').eq('sku', '21603').eq('activo', true).maybeSingle();
    if (soporte) {
      for (const cat of repetirAlInicio) {
        const i = filas.findIndex((f) => f.categoria_id === cat);
        if (i >= 0) filas.splice(i, 0, { id: soporte.id, sku: '21603', categoria_id: cat });
      }
    }
  }
  const rejilla = montarRejilla(filas,[idPorSlug.get('vimar-linea-mecanismos'), idPorSlug.get('vimar-knx-linea')], [idPorSlug.get('vimar-linea-placas'), idPorSlug.get('vimar-linea-teclas'), idPorSlug.get('vimar-linea-tapas-ciegas'), idPorSlug.get('vimar-knx-eikon'), idPorSlug.get('vimar-knx-eikon-vintage'), idPorSlug.get('vimar-knx-eikon-flat-tondo')]);
  totalPaginas = Math.max(1, Math.ceil(rejilla.length / POR_PAGINA));
  const trozo = rejilla.slice((pagina - 1) * POR_PAGINA, pagina * POR_PAGINA);
  const ids = [...new Set(trozo.filter((c): c is string => typeof c === 'string'))];
  const { data: detalles } = ids.length
    ? await supabase.from('productos').select(CAMPOS).in('id', ids)
    : { data: [] };
  const porId = new Map(((detalles ?? []) as Producto[]).map((p) => [p.id, p]));
  let inicio: number | undefined;
  for (const c of trozo) {
    if (c !== null && typeof c === 'object') {
      inicio = c.centrar;
      continue;
    }
    const p = c === null ? undefined : porId.get(c);
    casillas.push(p ? { p, inicio } : null);
    inicio = undefined;
  }
  // Quita huecos sobrantes al final de la última página.
  while (casillas.length > 0 && casillas[casillas.length - 1] === null) casillas.pop();
} else {
  const desde = (pagina - 1) * POR_PAGINA;
  const { data, count } = await consultaFiltrada(CAMPOS, { count: 'exact' }).range(desde, desde + POR_PAGINA - 1);
  casillas = ((data ?? []) as unknown as Producto[]).map((p) => ({ p }));
  total = count ?? 0;
  totalPaginas = Math.max(1, Math.ceil(total / POR_PAGINA));
}

// Precios de los productos de esta página (solo cuentas aprobadas).
if (aprobado) {
  const idsPagina = [...new Set(casillas.flatMap((c) => (c ? [c.p.id] : [])))];
  if (idsPagina.length) {
    const { data: precios } = await supabaseAdmin
      .from('productos')
      .select('id, precio, precio_oferta')
      .in('id', idsPagina)
      .eq('activo', true);
    const precioPorId = new Map((precios ?? []).map((x) => [x.id, x]));
    for (const c of casillas) {
      const x = c && precioPorId.get(c.p.id);
      if (c && x) Object.assign(c.p, { precio: x.precio, precio_oferta: x.precio_oferta });
    }
  }
}

// Rejilla de Vimar Linea · Mecanismos (y KNX · Mecanismos Linea) en filas de 4
// casillas (null = hueco):
//   - "mecanismo + 3 colores" (30000, 30000.B, 30000.C, 30000.G).
//   - Las versiones axiales usan el mecanismo de la alineada, que se repite:
//     30000A.B -> 30000 · 30000A.2B -> 30000.2 · 30000A.FX2B -> 30000.FX2.
//   - El pulsador inversor 30010 usa el mecanismo del pulsador 30008.
//   - Los grupos sin mecanismo llevan un hueco en blanco a la izquierda.
// Placas y teclas, en filas centradas de 3. Placas: cada fila es un tamaño en
// un trío de acabados (30642.00/.01/.02 tecno blanco, cáñamo y negro;
// .20/.21/.22; .40/.41/.42 Reflex; .60/.61/.62; .70.01/.71/.72).
// Teclas y tapas ciegas: cada fila es una referencia en blanco, cáñamo y negro.
// El resto de categorías van seguidas, sin huecos.
function montarRejilla(
  lista: { id: string; sku: string | null; categoria_id: string | null }[],
  idsMecanismos: (string | undefined)[] = [],
  idsCentradas: (string | undefined)[] = [],
): Celda[] {
  const centradas = new Set(idsCentradas.filter(Boolean));
  const mecanismos = new Set(idsMecanismos.filter(Boolean));
  const COMUN_ESPECIAL: Record<string, string> = { '30010': '30008' };
  const idPorSku = new Map(lista.map((p) => [p.sku ?? '', p.id]));
  // "30000.B" -> "30000", "30000.2B" -> "30000.2", "30203.R" -> "30203"; sin color, igual.
  // Productos distintos que van juntos en la misma fila.
  // Luz de emergencia y mando de 4 pulsadores, en la fila de la lámpara LED.
  // KNX Linea: los cuatro mandos de 4 pulsadores, juntos en una fila.
  const MISMA_FILA: Record<string, string> = {
    '30398': '30397',
    '30406': '30397',
    '30581': '30580',
    '30582': '30580',
    '30583': '30580',
  };
  const familia = (sku: string) =>
    MISMA_FILA[sku] ?? (/\.(.*[BCG]|R)$/.test(sku) ? sku.slice(0, -1).replace(/\.$/, '') : sku);
  const tieneColor = (sku: string) => familia(sku) !== sku;
  const comunDe = (fam: string) => {
    if (COMUN_ESPECIAL[fam]) return COMUN_ESPECIAL[fam];
    const m = fam.match(/^(\d{5})A(?:\.(.*))?$/);
    return m ? (m[2] ? `${m[1]}.${m[2]}` : m[1]) : null;
  };

  // "30642.21" -> "30642|2" (placa 2M, trío de acabados 20-22).
  const trioPlaca = (sku: string) => {
    const [fam, acabado = ''] = sku.split('.');
    return `${fam}|${acabado.charAt(0)}`;
  };

  const salida: Celda[] = [];
  let i = 0;
  while (i < lista.length) {
    const p = lista[i];
    if (p.categoria_id && centradas.has(p.categoria_id) && p.sku) {
      const cat = p.categoria_id;
      // Cómo se agrupan las filas: placas por tamaño y trío de acabados;
      // Eikon Vintage por referencia (22581, 22582: sus 6 acabados en 2 filas);
      // Eikon Táctil y Flat/Tondo: primero soporte y mandos juntos, luego las
      // etiquetas o las teclas (cada tecla Flat/Tondo con sus acabados:
      // 22751.0.01, .03… y las neutras iluminables 22751.01, .03… juntas);
      // el resto, por referencia sin color. Las placas Eikon (2267x, 2268x) van
      // por formato: la referencia sin el acabado final (22682.RN.1.01 -> 22682.RN.1).
      const sinAcabado = (sku: string) => sku.split('.').slice(0, -1).join('.');
      const eikonTeclas = (sku: string) =>
        /^2184[67]/.test(sku) ? 'etiquetas'
        : /^21662\./.test(sku) ? 'placas-tactil'
        : /^226[789]\d\./.test(sku) ? sinAcabado(sku)
        : /^22751\.\d\d$/.test(sku) ? 'iluminables'
        : /^22751\.[^.]+\./.test(sku) ? sku.split('.').slice(0, 2).join('.')
        : 'cabecera';
      const clave = (sku: string) =>
        cat === idsCentradas[0] ? trioPlaca(sku)
        : cat === idsCentradas[4] ? (/^2267\d\./.test(sku) ? sinAcabado(sku) : sku.split('.')[0])
        : cat === idsCentradas[3] || cat === idsCentradas[5] ? eikonTeclas(sku)
        : familia(sku);
      const grupo = clave(p.sku);
      const ids: string[] = [];
      while (ids.length < 3 && i < lista.length && lista[i].categoria_id === cat && lista[i].sku && clave(lista[i].sku!) === grupo) {
        ids.push(lista[i].id);
        i++;
      }
      // Siempre 4 casillas por fila (marcador + productos + huecos) para que
      // las páginas de 48 casillas corten por filas completas.
      salida.push({ centrar: ids.length }, ...ids, ...Array(3 - ids.length).fill(null));
      continue;
    }
    if (!p.categoria_id || !mecanismos.has(p.categoria_id) || !p.sku) {
      salida.push(p.id);
      i++;
      continue;
    }
    // Grupo: productos seguidos de la misma familia.
    const fam = familia(p.sku);
    const grupo: string[] = [];
    while (i < lista.length && lista[i].categoria_id === p.categoria_id && lista[i].sku && familia(lista[i].sku!) === fam) {
      grupo.push(lista[i].sku!);
      i++;
    }
    const conMecanismo = grupo.some((s) => !tieneColor(s));
    const comun = conMecanismo ? null : comunDe(fam);
    const fila: (string | null)[] = grupo.map((s) => idPorSku.get(s)!);
    if (comun && idPorSku.has(comun)) fila.unshift(idPorSku.get(comun)!);
    else if (!conMecanismo && fila.length === 3) fila.unshift(null);
    while (fila.length % 4 !== 0) fila.push(null);
    salida.push(...fila);
  }
  return salida;
}

// URL actual con algunos parámetros cambiados (null = quitar). Cambiar filtros
// siempre vuelve a la página 1.
function urlCon(cambios: Record<string, string | string[] | null>) {
  const p = new URLSearchParams(params);
  if (!('pagina' in cambios)) p.delete('pagina');
  for (const [clave, valor] of Object.entries(cambios)) {
    p.delete(clave);
    if (valor === null) continue;
    for (const v of Array.isArray(valor) ? valor : [valor]) p.append(clave, v);
  }
  const qs = p.toString();
  return qs ? `/productos?${qs}` : '/productos';
}

// Nombre legible de una categoría: "Vimar Linea · Placas" si tiene sección.
const categoriaPorSlug = new Map(categoriasPlano.map((c) => [c.slug, c]));
const nombreCategoria = (slug: string) => {
  const c = categoriaPorSlug.get(slug);
  if (!c) return slug;
  return c.seccion && c.seccion !== 'Otros' ? `${c.seccion} · ${c.nombre}` : c.nombre;
};

// Título de la página según lo que se esté viendo.
const grupoCompleto = tiendaMenu.find(
  (g) => g.categorias.length === categoriasSeleccionadas.length && g.categorias.every((c) => categoriasSeleccionadas.includes(c.slug))
);
let titulo = 'Catálogo de productos';
if (busqueda) titulo = `Resultados para «${busqueda}»`;
else if (categoriasSeleccionadas.length === 1) titulo = nombreCategoria(categoriasSeleccionadas[0]);
else if (grupoCompleto) titulo = grupoCompleto.titulo;
else if (categoriasSeleccionadas.length === 0 && marcasSeleccionadas.length === 1) titulo = `Productos ${marcasSeleccionadas[0]}`;

// Etiquetas de filtros activos (cada una enlaza a la misma búsqueda sin ese filtro).
const chips = [
  ...(busqueda ? [{ texto: `«${busqueda}»`, href: urlCon({ q: null }) }] : []),
  ...categoriasSeleccionadas.map((slug) => ({
    texto: nombreCategoria(slug),
    href: urlCon({ categoria: categoriasSeleccionadas.filter((s) => s !== slug) }),
  })),
  ...marcasSeleccionadas.map((m) => ({ texto: m, href: urlCon({ marca: marcasSeleccionadas.filter((x) => x !== m) }) })),
];

// Páginas a mostrar en la paginación: primera, última y las cercanas a la actual.
const paginasVisibles = [...new Set([1, pagina - 1, pagina, pagina + 1, totalPaginas])]
  .filter((n) => n >= 1 && n <= totalPaginas)
  .sort((a, b) => a - b);
---
<Base
  title={`${titulo} | AVCI Smart Homes`}
  description="Catálogo de productos KNX, mecanismos, iluminación y sonido de AVCI Smart Homes."
>
  <div class="catalogo">
    <aside class="filtros" id="panel-filtros">
      <div class="filtros-cabecera">
        <h2>Filtrar</h2>
        <button type="button" class="cerrar-filtros" aria-label="Cerrar filtros">&times;</button>
      </div>

      <form id="form-filtros" method="get" action="/productos">
        {busqueda && <input type="hidden" name="q" value={busqueda} />}
        {orden !== 'recomendado' && <input type="hidden" name="orden" value={orden} />}

        {tiendaMenu.map((grupo) => {
          const seleccionadas = grupo.categorias.filter((c) => categoriasSeleccionadas.includes(c.slug)).length;
          const todas = seleccionadas === grupo.categorias.length;
          return (
            <details class="filtro-grupo" open={seleccionadas > 0}>
              <summary>
                <span>{grupo.titulo}</span>
                {seleccionadas > 0 && <span class="contador">{seleccionadas}</span>}
              </summary>
              <div class="filtro-cuerpo">
                <label class="check-item check-todos">
                  <input type="checkbox" class="grupo-checkbox" checked={todas} />
                  Todo
                </label>
                {seccionesDe(grupo).map((s) => (
                  <div class="filtro-seccion">
                    {s.seccion && <p class="filtro-seccion-titulo">{s.seccion}</p>}
                    {s.categorias.map((c) => (
                      <label class="check-item">
                        <input type="checkbox" name="categoria" value={c.slug} checked={categoriasSeleccionadas.includes(c.slug)} />
                        {c.nombre}
                      </label>
                    ))}
                  </div>
                ))}
              </div>
            </details>
          );
        })}

        <details class="filtro-grupo" open>
          <summary>
            <span>Marca</span>
            {marcasSeleccionadas.length > 0 && <span class="contador">{marcasSeleccionadas.length}</span>}
          </summary>
          <div class="filtro-cuerpo">
            {marcasBase.map((marca) => (
              <label class="check-item">
                <input type="checkbox" name="marca" value={marca} checked={marcasSeleccionadas.includes(marca)} />
                {marca}
              </label>
            ))}
          </div>
        </details>

        <noscript><button type="submit" class="aplicar">Aplicar filtros</button></noscript>
      </form>
    </aside>
    <div class="filtros-fondo" aria-hidden="true"></div>

    <div class="resultados">
      <div class="resultados-cabecera">
        <h1>{titulo}</h1>
        <form class="buscador" method="get" action="/productos" role="search">
          {categoriasSeleccionadas.map((c) => <input type="hidden" name="categoria" value={c} />)}
          {marcasSeleccionadas.map((m) => <input type="hidden" name="marca" value={m} />)}
          {orden !== 'recomendado' && <input type="hidden" name="orden" value={orden} />}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M20 20L15.5 15.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input type="search" name="q" value={busqueda} placeholder="Buscar por nombre o referencia (ej. 30000, placa 2M)" aria-label="Buscar productos" />
          <button type="submit">Buscar</button>
        </form>
      </div>

      <div class="barra">
        <button type="button" class="abrir-filtros">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6H20M7 12H17M10 18H14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Filtros{chips.length > 0 && ` (${chips.length})`}
        </button>
        <p class="total">{total === 1 ? '1 producto' : `${total.toLocaleString('es-ES')} productos`}</p>
        <label class="orden">
          <span>Ordenar por</span>
          <select name="orden" form="form-filtros">
            <option value="recomendado" selected={orden === 'recomendado'}>Recomendado</option>
            <option value="nombre" selected={orden === 'nombre'}>Nombre</option>
            <option value="referencia" selected={orden === 'referencia'}>Referencia</option>
          </select>
        </label>
      </div>

      {chips.length > 0 && (
        <div class="chips">
          {chips.map((c) => (
            <a class="chip" href={c.href} aria-label={`Quitar filtro ${c.texto}`}>
              {c.texto} <span aria-hidden="true">✕</span>
            </a>
          ))}
          <a class="limpiar" href="/productos">Limpiar todo</a>
        </div>
      )}

      {casillas.length > 0 ? (
        <div class="grid">
          {casillas.map((c) => c === null ? (
            <div class="hueco" aria-hidden="true" />
          ) : (
            <a
              class:list={['card', c.inicio && `inicio-${c.inicio}`]}
              href={`/productos/${c.p.slug}`}
            >
              <div class="card-imagen">
                {c.p.imagen_principal ? (
                  <img
                    src={c.p.imagen_principal.replace(/-800\.webp$/, '-400.webp')}
                    alt={c.p.nombre}
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="400"
                  />
                ) : (
                  <div class="sin-imagen" />
                )}
              </div>
              <h3>{c.p.nombre}</h3>
              <p class="card-meta">{[c.p.marca, c.p.sku && `Ref. ${c.p.sku}`].filter(Boolean).join(' · ')}</p>
              {(() => {
                const precio = precioTarjeta(c.p);
                return precio.importe ? (
                  <p class="card-precio">
                    {precio.antes && <s class="precio-antes">{precio.antes}</s>}
                    <span class:list={['precio-ahora', { 'precio-ahora--rebajado': precio.antes }]}>{precio.importe}</span>
                    <span class="precio-iva">+ IVA</span>
                  </p>
                ) : (
                  <p class:list={['card-precio', 'card-precio--texto', { 'card-precio--login': !aprobado && COMPRAS_ACTIVAS }]}>{precio.texto}</p>
                );
              })()}
            </a>
          ))}
        </div>
      ) : (
        <div class="sin-resultados">
          <p>{hayFiltrosActivos ? 'No hay productos que coincidan con tu búsqueda.' : 'Todavía no hay productos publicados.'}</p>
          {hayFiltrosActivos && <a class="limpiar" href="/productos">Ver todo el catálogo</a>}
        </div>
      )}

      {totalPaginas > 1 && (
        <nav class="paginacion" aria-label="Páginas">
          {pagina > 1 ? <a href={urlCon({ pagina: String(pagina - 1) })} rel="prev">← Anterior</a> : <span class="deshabilitado">← Anterior</span>}
          <div class="numeros">
            {paginasVisibles.map((n, i) => (
              <>
                {i > 0 && n - paginasVisibles[i - 1] > 1 && <span class="puntos">…</span>}
                {n === pagina ? (
                  <span class="actual" aria-current="page">{n}</span>
                ) : (
                  <a href={urlCon({ pagina: String(n) })}>{n}</a>
                )}
              </>
            ))}
          </div>
          {pagina < totalPaginas ? <a href={urlCon({ pagina: String(pagina + 1) })} rel="next">Siguiente →</a> : <span class="deshabilitado">Siguiente →</span>}
        </nav>
      )}
    </div>
  </div>

  <script>
    const form = document.getElementById('form-filtros') as HTMLFormElement | null;
    const enviar = () => form?.requestSubmit();

    // Los filtros se aplican al marcarlos, sin botón "Aplicar".
    form?.querySelectorAll<HTMLInputElement>('input[name="categoria"], input[name="marca"]').forEach((input) => {
      input.addEventListener('change', enviar);
    });
    document.querySelector<HTMLSelectElement>('select[name="orden"]')?.addEventListener('change', enviar);

    // "Todo" marca o desmarca todas las categorías del grupo de una vez.
    form?.querySelectorAll<HTMLElement>('.filtro-grupo').forEach((grupo) => {
      const todo = grupo.querySelector<HTMLInputElement>('.grupo-checkbox');
      const hijos = grupo.querySelectorAll<HTMLInputElement>('input[name="categoria"]');
      todo?.addEventListener('change', () => {
        hijos.forEach((h) => { h.checked = todo.checked; });
        enviar();
      });
    });

    // Móvil: el panel de filtros se abre como un cajón lateral.
    const panel = document.getElementById('panel-filtros');
    const abrir = () => document.body.classList.add('filtros-abiertos');
    const cerrar = () => document.body.classList.remove('filtros-abiertos');
    document.querySelector('.abrir-filtros')?.addEventListener('click', abrir);
    panel?.querySelector('.cerrar-filtros')?.addEventListener('click', cerrar);
    document.querySelector('.filtros-fondo')?.addEventListener('click', cerrar);
  </script>

  <style>
    .catalogo {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 3rem;
      padding: 2.5rem 2rem 4rem;
      align-items: start;
    }

    /* ---------- Filtros ---------- */
    .filtros { position: sticky; top: 100px; max-height: calc(100vh - 120px); overflow-y: auto; padding-right: 0.25rem; }
    .filtros-cabecera { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
    .filtros-cabecera h2 { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); margin: 0; }
    .cerrar-filtros { display: none; background: none; border: none; font-size: 1.8rem; line-height: 1; cursor: pointer; color: var(--color-text); }

    .filtro-grupo { border-bottom: 1px solid var(--color-border); }
    .filtro-grupo summary {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.95rem 0;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
    }
    .filtro-grupo summary::-webkit-details-marker { display: none; }
    .filtro-grupo summary::after {
      content: '+';
      margin-left: auto;
      font-weight: 400;
      font-size: 1.2rem;
      color: var(--color-muted);
    }
    .filtro-grupo[open] summary::after { content: '–'; }
    .contador {
      background: var(--color-text);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      border-radius: 999px;
      min-width: 1.3rem;
      height: 1.3rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 0.35rem;
    }
    .filtro-cuerpo { padding: 0 0 0.9rem; }
    .filtro-seccion + .filtro-seccion { margin-top: 0.5rem; }
    .filtro-seccion-titulo {
      margin: 0.5rem 0 0.1rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .check-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.92rem;
      color: #333;
      padding: 0.35rem 0;
      cursor: pointer;
    }
    .check-item:hover { color: var(--color-text); }
    .check-item input { accent-color: var(--color-primary); width: 16px; height: 16px; margin: 0; }
    .check-todos { font-weight: 600; color: var(--color-text); }
    .aplicar {
      margin-top: 1rem;
      width: 100%;
      padding: 0.75rem;
      border-radius: 999px;
      border: none;
      background: var(--color-text);
      color: #fff;
      font-weight: 700;
      cursor: pointer;
    }
    .filtros-fondo { display: none; }

    /* ---------- Cabecera de resultados ---------- */
    .resultados-cabecera { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-bottom: 1.25rem; }
    .resultados-cabecera h1 { font-size: 1.6rem; margin: 0; }
    .buscador {
      flex: 1 1 360px;
      max-width: 520px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      padding: 0.3rem 0.3rem 0.3rem 1rem;
      background: #fff;
      color: var(--color-muted);
    }
    .buscador:focus-within { border-color: var(--color-text); }
    .buscador input { flex: 1; border: none; outline: none; font: inherit; font-size: 0.92rem; min-width: 0; background: none; }
    .buscador button {
      border: none;
      background: var(--color-text);
      color: #fff;
      border-radius: 999px;
      padding: 0.55rem 1.2rem;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
    }

    .barra {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 1rem;
    }
    .total { margin: 0; font-size: 0.9rem; color: var(--color-muted); }
    .orden { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; color: var(--color-muted); }
    .orden select {
      font: inherit;
      color: var(--color-text);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 0.4rem 0.6rem;
      background: #fff;
      cursor: pointer;
    }
    .abrir-filtros {
      display: none;
      align-items: center;
      gap: 0.4rem;
      border: 1px solid var(--color-text);
      background: #fff;
      border-radius: 999px;
      padding: 0.45rem 1rem;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; }
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: #f2f2f2;
      color: var(--color-text);
      border-radius: 999px;
      padding: 0.35rem 0.85rem;
      font-size: 0.85rem;
      text-decoration: none;
    }
    .chip span { font-size: 0.75rem; color: var(--color-muted); }
    .chip:hover { background: #e6e6e6; }
    .limpiar { font-size: 0.85rem; color: var(--color-text); font-weight: 600; text-underline-offset: 3px; }

    /* ---------- Tarjetas ---------- */
    .grid {
      display: grid;
      /* 4 tarjetas por fila (mecanismo + 3 colores). Se usan 8 columnas y cada
         tarjeta ocupa 2, así las filas de 3 (placas y teclas) se pueden centrar
         dejando media tarjeta a cada lado. */
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 2.25rem 1.25rem;
    }
    .grid > * { grid-column: span 2; }
    .grid > .inicio-3 { grid-column: 2 / span 2; }
    .grid > .inicio-2 { grid-column: 3 / span 2; }
    .grid > .inicio-1 { grid-column: 4 / span 2; }
    /* Tarjeta: la foto en un recuadro redondeado y el texto debajo, fuera. */
    .card {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      text-decoration: none;
      color: var(--color-text);
    }
    /* Recuadro cuadrado fijo: todas las fotos ocupan el mismo hueco con el
       mismo margen, sean altas (teclas 1M), cuadradas o anchas (placas 8M). */
    .card-imagen {
      position: relative;
      aspect-ratio: 1;
      overflow: hidden;
      margin-bottom: 0.75rem;
      background: #fff;
      border: 1px solid #e6e6e6;
      border-radius: 16px;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .card-imagen img { position: absolute; inset: 8%; width: 84%; height: 84%; object-fit: contain; transition: transform 0.3s ease; }
    .card:hover .card-imagen { box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08); border-color: transparent; }
    .card:hover .card-imagen img { transform: scale(1.03); }
    .sin-imagen { width: 100%; height: 100%; background: #f5f5f5; }
    .card h3 { font-size: 1rem; font-weight: 700; margin: 0; line-height: 1.3; }
    .card-meta { margin: 0; font-size: 0.85rem; color: var(--color-muted); }
    .card-precio { margin: 0.15rem 0 0; font-size: 1rem; font-weight: 800; }
    .card-precio .precio-iva { font-size: 0.8rem; font-weight: 600; color: var(--color-muted); }
    .card-precio .precio-antes { font-size: 0.85rem; font-weight: 500; color: var(--color-muted); margin-right: 0.3rem; }
    .card-precio .precio-ahora--rebajado { color: #d0021b; }
    .card-precio--texto { font-size: 0.85rem; font-weight: 400; color: var(--color-muted); }
    .card-precio.card-precio--login { color: #d0021b; font-weight: 600; }

    .sin-resultados { padding: 3rem 0; color: var(--color-muted); }

    /* ---------- Paginación ---------- */
    .paginacion { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; }
    .paginacion a, .paginacion span { font-size: 0.9rem; text-decoration: none; color: var(--color-text); }
    .paginacion .deshabilitado { color: #bbb; }
    .numeros { display: flex; gap: 0.3rem; }
    .numeros a, .numeros .actual, .numeros .puntos {
      min-width: 2.2rem;
      height: 2.2rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
    }
    .numeros a:hover { background: #f2f2f2; }
    .numeros .actual { background: var(--color-text); color: #fff; font-weight: 700; }

    /* ---------- Móvil ---------- */
    @media (max-width: 900px) {
      .catalogo { grid-template-columns: 1fr; padding: 1.5rem 1rem 3rem; gap: 0; }
      .abrir-filtros { display: inline-flex; }
      .filtros {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: min(340px, 88vw);
        max-height: none;
        background: #fff;
        z-index: 60;
        padding: 1.25rem 1.25rem 2rem;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
      }
      .cerrar-filtros { display: block; }
      :global(body.filtros-abiertos) .filtros { transform: none; }
      :global(body.filtros-abiertos) .filtros-fondo { display: block; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.4); z-index: 55; }
      .orden span { display: none; }
      .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem 0.75rem; }
      /* En el móvil (2 por fila) las filas de 3 no se centran: solo empiezan línea nueva. */
      .grid > .inicio-3, .grid > .inicio-2, .grid > .inicio-1 { grid-column: 1 / span 2; }
      .card h3 { font-size: 0.9rem; }
      .card-meta { font-size: 0.78rem; }
      .card-precio { font-size: 0.95rem; }
      .paginacion { flex-wrap: wrap; justify-content: center; }
    }
  </style>
</Base>
