---
// Necesita leer la sesión del usuario en cada visita, así que no se pregenera.
export const prerender = false;

import Base from '../layouts/Base.astro';
import { supabaseAdmin } from '../lib/supabase';

const tiposProfesional = [
  { value: 'integrador-pro', label: 'Integradores PRO' },
  { value: 'disenador', label: 'Diseñadores' },
  { value: 'propietario', label: 'Propietarios' },
  { value: 'arquitecto', label: 'Arquitectos' },
  { value: 'promotora-constructora', label: 'Promotoras / Constructoras' },
];

const user = Astro.locals.user;
let perfil: { estado: string; nombre: string } | null = null;

if (user) {
  const { data } = await supabaseAdmin.from('perfiles').select('estado, nombre').eq('id', user.id).single();
  perfil = data;
}
---
<Base title="Mi cuenta | AVCI Smart Homes" description="Inicia sesión o crea una cuenta en AVCI Smart Homes.">
  <section class="cuenta">
    {user ? (
      <div class="tarjeta tarjeta-estado">
        {perfil?.estado === 'aprobado' ? (
          <>
            <p class="estado-titulo">Has iniciado sesión</p>
            <p class="estado-detalle">{user.email}</p>
          </>
        ) : perfil?.estado === 'rechazado' ? (
          <>
            <p class="estado-titulo">Solicitud rechazada</p>
            <p class="estado-detalle">
              Tu solicitud de cuenta no ha sido aprobada. Si crees que es un error,
              <a href="/contacto">contacta con nosotros</a>.
            </p>
          </>
        ) : (
          <>
            <p class="estado-titulo">Cuenta pendiente de aprobación</p>
            <p class="estado-detalle">
              Hemos recibido tu solicitud y la estamos revisando. Te avisaremos por email
              en cuanto esté activa.
            </p>
          </>
        )}
        <button type="button" id="logout" class="enviar">Cerrar sesión</button>
      </div>
    ) : (
      <div class="tarjeta">
        <div class="tabs" role="tablist">
          <button type="button" class="tab activo" data-tab="login">Iniciar sesión</button>
          <button type="button" class="tab" data-tab="registro">Registrarse</button>
        </div>

        <form class="panel panel-login" data-panel="login" id="form-login">
          <input type="email" name="email" placeholder="Correo electrónico" aria-label="Correo electrónico" required />
          <input type="password" name="password" placeholder="Contraseña" aria-label="Contraseña" required />
          <p class="mensaje" hidden></p>
          <button type="submit" class="enviar">Iniciar sesión</button>
        </form>

        <form class="panel panel-registro" data-panel="registro" id="form-registro" hidden>
          <p class="aviso">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="currentColor"/><rect x="11" y="10.5" width="2" height="6.5" rx="1" fill="#fff"/><circle cx="12" cy="7.5" r="1.25" fill="#fff"/></svg>
            Revisaremos esta información para activar tu cuenta.
          </p>

          <div class="grid-2">
            <label class="campo">
              <span>Nombre <span class="req">*</span></span>
              <input type="text" name="nombre" required />
            </label>
            <label class="campo">
              <span>Nombre de la empresa <span class="req">*</span></span>
              <input type="text" name="empresa" required />
            </label>

            <label class="campo">
              <span>Apellidos <span class="req">*</span></span>
              <input type="text" name="apellidos" required />
            </label>
            <label class="campo">
              <span>CIF/NIF <span class="req">*</span></span>
              <input type="text" name="cifNif" required />
            </label>

            <label class="campo">
              <span>Tipo de profesional <span class="req">*</span></span>
              <select name="tipoProfesional" required>
                <option value="" disabled selected>Selecciona una opción</option>
                {tiposProfesional.map((t) => <option value={t.value}>{t.label}</option>)}
              </select>
            </label>
            <label class="campo">
              <span>Dirección <span class="req">*</span></span>
              <input type="text" name="direccion" required />
            </label>

            <label class="campo">
              <span>Correo electrónico <span class="req">*</span></span>
              <input type="email" name="email" required />
            </label>
            <label class="campo">
              <span>Contraseña <span class="req">*</span></span>
              <input type="password" name="password" required minlength="8" />
            </label>
          </div>

          <label class="privacidad">
            <input type="checkbox" name="privacidad" required />
            He leído y acepto la <a href="/privacidad">política de privacidad</a>
          </label>

          <p class="mensaje" hidden></p>
          <button type="submit" class="enviar">Registrarse</button>
        </form>
      </div>
    )}
  </section>

  <script>
    import { supabaseBrowser } from '../lib/supabase-browser';

    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) => b.classList.remove('activo'));
        document.querySelectorAll<HTMLElement>('.panel').forEach((p) => { p.hidden = true; });
        tab.classList.add('activo');
        const panel = document.querySelector<HTMLElement>(`[data-panel="${tab.dataset.tab}"]`);
        if (panel) panel.hidden = false;
      });
    });

    function mostrarMensaje(form: HTMLFormElement, texto: string, tipo: 'ok' | 'error') {
      const mensaje = form.querySelector<HTMLElement>('.mensaje');
      if (!mensaje) return;
      mensaje.textContent = texto;
      mensaje.className = `mensaje ${tipo}`;
      mensaje.hidden = false;
    }

    function setCargando(boton: HTMLButtonElement, cargando: boolean, textoNormal: string) {
      boton.disabled = cargando;
      boton.textContent = cargando ? 'Un momento…' : textoNormal;
    }

    document.getElementById('form-login')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const email = (form.elements.namedItem('email') as HTMLInputElement).value;
      const password = (form.elements.namedItem('password') as HTMLInputElement).value;

      setCargando(boton, true, 'Iniciar sesión');

      const { data, error } = await supabaseBrowser.auth.signInWithPassword({ email, password });

      if (error || !data.user) {
        setCargando(boton, false, 'Iniciar sesión');
        mostrarMensaje(form, 'Correo o contraseña incorrectos.', 'error');
        return;
      }

      const { data: perfil } = await supabaseBrowser
        .from('perfiles')
        .select('estado')
        .eq('id', data.user.id)
        .single();

      if (perfil?.estado !== 'aprobado') {
        await supabaseBrowser.auth.signOut();
        setCargando(boton, false, 'Iniciar sesión');
        mostrarMensaje(
          form,
          perfil?.estado === 'rechazado'
            ? 'Tu solicitud de cuenta ha sido rechazada.'
            : 'Tu cuenta todavía está pendiente de aprobación. Te avisaremos por email.',
          'error'
        );
        return;
      }

      window.location.reload();
    });

    document.getElementById('form-registro')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const datos = new FormData(form);

      setCargando(boton, true, 'Registrarse');

      const res = await fetch('/api/registro', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre: datos.get('nombre'),
          apellidos: datos.get('apellidos'),
          empresa: datos.get('empresa'),
          cifNif: datos.get('cifNif'),
          tipoProfesional: datos.get('tipoProfesional'),
          direccion: datos.get('direccion'),
          email: datos.get('email'),
          password: datos.get('password'),
        }),
      });
      const respuesta = await res.json();

      setCargando(boton, false, 'Registrarse');

      if (!res.ok) {
        mostrarMensaje(form, respuesta.error ?? 'No se pudo completar el registro.', 'error');
        return;
      }

      form.reset();
      mostrarMensaje(form, 'Solicitud enviada. Revisaremos tu cuenta y te avisaremos por email en cuanto esté activa.', 'ok');
    });

    document.getElementById('logout')?.addEventListener('click', async () => {
      await supabaseBrowser.auth.signOut();
      window.location.reload();
    });
  </script>

  <style>
    .cuenta {
      display: flex;
      justify-content: center;
      padding: 5rem 2rem;
      min-height: calc(100vh - 82px);
      background: #f7f7f7;
    }
    .tarjeta {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
      padding: 2.5rem;
      width: 100%;
      max-width: 760px;
      height: fit-content;
    }
    .tarjeta-estado { max-width: 460px; text-align: center; }
    .estado-titulo { font-size: 1.25rem; font-weight: 700; margin: 0 0 0.75rem; }
    .estado-detalle { color: var(--color-muted); margin: 0 0 1.5rem; line-height: 1.6; }
    .estado-detalle a { color: var(--color-text); }
    .tarjeta-estado .enviar { background: var(--color-text); }

    .tabs { display: flex; gap: 0.5rem; margin-bottom: 2rem; max-width: 380px; }
    .tab {
      flex: 1;
      background: none;
      border: none;
      border-bottom: 2px solid var(--color-border);
      padding: 0.75rem;
      font: inherit;
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--color-muted);
      cursor: pointer;
    }
    .tab.activo { color: var(--color-text); border-bottom-color: var(--color-text); }

    .panel-login { display: flex; flex-direction: column; gap: 1rem; max-width: 380px; }
    /* Más específica que ".panel-login"/".panel-registro" para que gane sobre su display:flex */
    .panel[hidden] { display: none; }
    .panel input[type='text'],
    .panel input[type='email'],
    .panel input[type='password'],
    .panel select {
      width: 100%;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      padding: 0.85rem 1rem;
      font: inherit;
      color: var(--color-text);
      background: #fff;
    }
    .panel input:focus,
    .panel select:focus { outline: none; border-color: var(--color-primary); }

    .panel-registro { display: flex; flex-direction: column; gap: 1.5rem; }
    .aviso {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: #f5f5f5;
      border-radius: 8px;
      padding: 0.85rem 1rem;
      font-size: 0.9rem;
      margin: 0;
    }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 1.5rem; }
    @media (max-width: 600px) {
      .grid-2 { grid-template-columns: 1fr; }
    }
    .campo { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9rem; font-weight: 600; }
    .req { color: #d33; }

    .privacidad {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--color-muted);
    }
    .privacidad input { accent-color: var(--color-primary); margin-top: 0.2rem; }
    .privacidad a { color: var(--color-text); }

    .mensaje {
      border-radius: 6px;
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
      margin: 0;
    }
    .mensaje.ok { background: #eef4ff; border: 1px solid var(--color-primary); }
    .mensaje.error { background: #fdeeee; border: 1px solid #d33; color: #a00; }

    .enviar {
      align-self: flex-start;
      background: var(--color-primary);
      color: var(--color-primary-text);
      border: none;
      cursor: pointer;
      padding: 0.9rem 2rem;
      border-radius: 999px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.85rem;
    }
    .enviar:disabled { opacity: 0.6; cursor: default; }
  </style>
</Base>
