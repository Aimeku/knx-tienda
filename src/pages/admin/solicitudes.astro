---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { esAdmin } from '../../lib/admin';

const user = Astro.locals.user;
if (!user || !esAdmin(user.email)) {
  return Astro.redirect('/cuenta?volver=/admin/solicitudes');
}

const { data: perfiles } = await supabaseAdmin
  .from('perfiles')
  .select('id, email, nombre, apellidos, empresa, cif_nif, tipo_profesional, direccion, estado, created_at, codigo_descuento')
  .order('created_at', { ascending: false });

const { data: codigos } = await supabaseAdmin
  .from('codigos_descuento')
  .select('codigo, tipo, valor, usos, usos_max, caduca, activo, descripcion')
  .order('created_at', { ascending: false });
const codigosPorcentaje = (codigos ?? []).filter((c) => c.tipo === 'porcentaje');
const textoCodigo = (c: { codigo: string; tipo: string; valor: number }) =>
  `${c.codigo} (${c.tipo === 'porcentaje' ? `-${Number(c.valor).toLocaleString('es-ES')} %` : `-${Number(c.valor).toLocaleString('es-ES')} €`})`;

const etiquetasTipo: Record<string, string> = {
  'integrador-pro': 'Integrador PRO',
  disenador: 'Diseñador',
  propietario: 'Propietario',
  arquitecto: 'Arquitecto',
  'promotora-constructora': 'Promotora / Constructora',
};

const pendientes = (perfiles ?? []).filter((p) => p.estado === 'pendiente');
const resueltos = (perfiles ?? []).filter((p) => p.estado !== 'pendiente');
---
<Base title="Solicitudes de cuenta | AVCI Smart Homes">
  <section class="admin">
    <h1>Solicitudes de cuenta</h1>
    <p class="subtitulo">Conectado como {user.email}. <button type="button" id="logout" class="link-boton">Cerrar sesión</button></p>

    <h2>Pendientes ({pendientes.length})</h2>
    {pendientes.length === 0 ? (
      <p class="vacio">No hay solicitudes pendientes.</p>
    ) : (
      <div class="tabla">
        {pendientes.map((p) => (
          <div class="fila" data-id={p.id}>
            <div class="datos">
              <p class="nombre">{p.nombre} {p.apellidos} — {p.empresa}</p>
              <p class="detalle">{p.email} · {etiquetasTipo[p.tipo_profesional] ?? p.tipo_profesional} · CIF/NIF {p.cif_nif}</p>
              <p class="detalle">{p.direccion}</p>
              <p class="fecha">Solicitado el {new Date(p.created_at).toLocaleDateString('es-ES')}</p>
            </div>
            <div class="acciones">
              <button type="button" class="aprobar" data-id={p.id}>Aprobar</button>
              <button type="button" class="rechazar" data-id={p.id}>Rechazar</button>
              <button type="button" class="eliminar" data-id={p.id} data-nombre={`${p.nombre} ${p.apellidos} (${p.email})`}>Eliminar</button>
            </div>
          </div>
        ))}
      </div>
    )}

    <h2>Resueltas</h2>
    {resueltos.length === 0 ? (
      <p class="vacio">Todavía no hay ninguna.</p>
    ) : (
      <table class="historial">
        <thead>
          <tr><th>Nombre</th><th>Empresa</th><th>Email</th><th>Estado</th><th>Descuento</th><th></th></tr>
        </thead>
        <tbody>
          {resueltos.map((p) => (
            <tr>
              <td>{p.nombre} {p.apellidos}</td>
              <td>{p.empresa}</td>
              <td>{p.email}</td>
              <td><span class={`estado estado-${p.estado}`}>{p.estado}</span></td>
              <td>
                {p.estado === 'aprobado' && !esAdmin(p.email) ? (
                  <select class="asignar-codigo" data-id={p.id} aria-label={`Descuento de ${p.nombre}`}>
                    <option value="">Sin descuento</option>
                    {codigosPorcentaje.map((c) => (
                      <option value={c.codigo} selected={c.codigo === p.codigo_descuento}>
                        {textoCodigo(c)}{c.activo ? '' : ' · inactivo'}
                      </option>
                    ))}
                  </select>
                ) : p.codigo_descuento ? <span class="detalle-codigo">{p.codigo_descuento}</span> : null}
              </td>
              <td class="celda-accion">
                {esAdmin(p.email) ? (
                  <span class="admin-etiqueta">Admin</span>
                ) : (
                  <>
                  {p.estado === 'aprobado' && (
                    <button type="button" class="boton-tabla inhabilitar" data-id={p.id} data-nombre={`${p.nombre} ${p.apellidos} (${p.email})`}>Inhabilitar</button>
                  )}
                  {p.estado === 'inhabilitado' && (
                    <button type="button" class="boton-tabla reactivar" data-id={p.id} data-nombre={`${p.nombre} ${p.apellidos} (${p.email})`}>Reactivar</button>
                  )}
                  <button type="button" class="eliminar eliminar--tabla" data-id={p.id} data-nombre={`${p.nombre} ${p.apellidos} (${p.email})`}>Eliminar</button>
                  </>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <h2>Códigos de descuento</h2>
    <form id="form-codigo" class="form-codigo">
      <label>Código<input name="codigo" required minlength="3" maxlength="40" placeholder="INSTALADOR15" /></label>
      <label>Descuento %<input name="porcentaje" type="number" required min="0.01" max="100" step="0.01" placeholder="15" /></label>
      <label>Caduca (opcional)<input name="caduca" type="date" /></label>
      <label class="ancho">Nota (opcional)<input name="descripcion" maxlength="200" placeholder="Para instaladores habituales" /></label>
      <button type="submit" class="boton-crear">Crear código</button>
    </form>
    <p class="ayuda">Un código se puede dar al cliente para que lo escriba en el carrito, o asignarlo a su cuenta (columna «Descuento» de arriba): entonces verá todos los precios rebajados automáticamente.</p>
    {(codigos ?? []).length === 0 ? (
      <p class="vacio">Todavía no hay códigos.</p>
    ) : (
      <table class="historial">
        <thead>
          <tr><th>Código</th><th>Descuento</th><th>Usos</th><th>Caduca</th><th>Cuentas</th><th></th></tr>
        </thead>
        <tbody>
          {(codigos ?? []).map((c) => (
            <tr class:list={{ 'codigo-inactivo': !c.activo }}>
              <td><strong>{c.codigo}</strong>{c.descripcion && <span class="detalle-codigo"><br />{c.descripcion}</span>}</td>
              <td>{c.tipo === 'porcentaje' ? `${Number(c.valor).toLocaleString('es-ES')} %` : `${Number(c.valor).toLocaleString('es-ES')} €`}</td>
              <td>{c.usos}{c.usos_max != null && ` / ${c.usos_max}`}</td>
              <td>{c.caduca ? new Date(c.caduca).toLocaleDateString('es-ES') : '—'}</td>
              <td>{(perfiles ?? []).filter((p) => p.codigo_descuento === c.codigo).length}</td>
              <td class="celda-accion">
                <button type="button" class="boton-tabla activar-codigo" data-codigo={c.codigo} data-activo={c.activo ? '0' : '1'}>
                  {c.activo ? 'Desactivar' : 'Activar'}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>

  <script>
    import { supabaseBrowser } from '../../lib/supabase-browser';

    async function actualizar(id: string, accion: 'aprobar' | 'rechazar') {
      const res = await fetch('/api/admin/perfil', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, accion }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('No se pudo actualizar la solicitud.');
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.aprobar').forEach((btn) => {
      btn.addEventListener('click', () => actualizar(btn.dataset.id!, 'aprobar'));
    });
    document.querySelectorAll<HTMLButtonElement>('.rechazar').forEach((btn) => {
      btn.addEventListener('click', () => actualizar(btn.dataset.id!, 'rechazar'));
    });

    document.querySelectorAll<HTMLButtonElement>('.eliminar').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const ok = confirm(
          `¿Eliminar la cuenta de ${btn.dataset.nombre}?

` +
          'Se borrarán su usuario y sus datos de registro, y ya no podrá iniciar sesión. ' +
          'Sus pedidos se conservan. Esta acción no se puede deshacer.'
        );
        if (!ok) return;
        btn.disabled = true;
        const res = await fetch('/api/admin/perfil', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: btn.dataset.id, accion: 'eliminar' }),
        });
        const r = await res.json().catch(() => ({}));
        if (res.ok) window.location.reload();
        else {
          btn.disabled = false;
          alert(r.error || 'No se pudo eliminar la cuenta.');
        }
      });
    });

    async function cambiarHabilitada(btn: HTMLButtonElement, accion: 'inhabilitar' | 'reactivar') {
      const ok = confirm(accion === 'inhabilitar'
        ? `¿Inhabilitar la cuenta de ${btn.dataset.nombre}?

No podrá iniciar sesión, ver precios ni comprar hasta que la reactives. No se borra nada.`
        : `¿Reactivar la cuenta de ${btn.dataset.nombre}?

Volverá a poder iniciar sesión, ver precios y comprar.`);
      if (!ok) return;
      btn.disabled = true;
      const res = await fetch('/api/admin/perfil', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: btn.dataset.id, accion }),
      });
      const r = await res.json().catch(() => ({}));
      if (res.ok) window.location.reload();
      else {
        btn.disabled = false;
        alert(r.error || 'No se pudo cambiar el estado de la cuenta.');
      }
    }
    document.querySelectorAll<HTMLButtonElement>('.inhabilitar').forEach((btn) => {
      btn.addEventListener('click', () => cambiarHabilitada(btn, 'inhabilitar'));
    });
    document.querySelectorAll<HTMLButtonElement>('.reactivar').forEach((btn) => {
      btn.addEventListener('click', () => cambiarHabilitada(btn, 'reactivar'));
    });

    async function llamar(cuerpo: Record<string, unknown>) {
      const res = await fetch('/api/admin/perfil', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cuerpo),
      });
      const r = await res.json().catch(() => ({}));
      if (!res.ok) alert(r.error || 'No se pudo guardar.');
      return res.ok;
    }

    document.querySelectorAll<HTMLSelectElement>('.asignar-codigo').forEach((sel) => {
      let anterior = sel.value;
      sel.addEventListener('change', async () => {
        sel.disabled = true;
        const ok = await llamar({ accion: 'asignar_codigo', id: sel.dataset.id, codigo: sel.value });
        sel.disabled = false;
        if (!ok) { sel.value = anterior; return; }
        anterior = sel.value;
        sel.classList.add('guardado');
        setTimeout(() => sel.classList.remove('guardado'), 1200);
      });
    });

    document.getElementById('form-codigo')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const datos = Object.fromEntries(new FormData(form));
      if (await llamar({ accion: 'crear_codigo', ...datos })) window.location.reload();
    });

    document.querySelectorAll<HTMLButtonElement>('.activar-codigo').forEach((btn) => {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        if (await llamar({ accion: 'activar_codigo', codigo: btn.dataset.codigo, activo: btn.dataset.activo === '1' })) window.location.reload();
        else btn.disabled = false;
      });
    });

    document.getElementById('logout')?.addEventListener('click', async () => {
      await supabaseBrowser.auth.signOut();
      window.location.href = '/cuenta';
    });
  </script>

  <style>
    .admin { max-width: 900px; margin: 0 auto; padding: 3rem 2rem 6rem; }
    .admin h1 { font-size: 1.75rem; margin: 0 0 0.5rem; }
    .subtitulo { color: var(--color-muted); margin: 0 0 3rem; }
    .link-boton {
      background: none;
      border: none;
      padding: 0;
      color: var(--color-text);
      text-decoration: underline;
      cursor: pointer;
      font: inherit;
    }
    .admin h2 { font-size: 1.15rem; margin: 2.5rem 0 1rem; }
    .vacio { color: var(--color-muted); font-style: italic; }

    .tabla { display: flex; flex-direction: column; gap: 1rem; }
    .fila {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
    }
    .datos .nombre { font-weight: 700; margin: 0 0 0.35rem; }
    .datos .detalle { color: var(--color-muted); font-size: 0.9rem; margin: 0 0 0.2rem; }
    .datos .fecha { color: var(--color-muted); font-size: 0.8rem; margin: 0.4rem 0 0; }

    .acciones { display: flex; gap: 0.6rem; flex-shrink: 0; }
    .acciones button {
      border: none;
      cursor: pointer;
      padding: 0.6rem 1.25rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .aprobar { background: var(--color-text); color: #fff; }
    .rechazar { background: #fff; color: var(--color-text); border: 1px solid var(--color-border) !important; }
    .eliminar { background: #fff; color: #a00; border: 1px solid #e6b3b3 !important; }
    .celda-accion { white-space: nowrap; }
    .celda-accion button + button { margin-left: 0.4rem; }
    .boton-tabla, .eliminar--tabla {
      cursor: pointer;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .eliminar:disabled { opacity: 0.5; cursor: wait; }
    .celda-accion { text-align: right; }
    .admin-etiqueta { font-size: 0.75rem; color: var(--color-muted); font-weight: 600; }

    .historial { width: 100%; border-collapse: collapse; }
    .historial th, .historial td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; }
    .estado { text-transform: capitalize; font-weight: 600; }
    .estado-aprobado { color: #1a7f37; }
    .estado-rechazado { color: #a00; }
    .estado-inhabilitado { color: #b26a00; }
    .asignar-codigo { font: inherit; font-size: 0.85rem; padding: 0.3rem 0.4rem; border: 1px solid var(--color-border); border-radius: 6px; max-width: 12rem; transition: border-color 0.3s; }
    .asignar-codigo.guardado { border-color: #1a7f37; }
    .detalle-codigo { font-size: 0.8rem; color: var(--color-muted); }
    .form-codigo { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end; margin-bottom: 0.75rem; }
    .form-codigo label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.8rem; font-weight: 600; }
    .form-codigo input { font: inherit; font-size: 0.9rem; padding: 0.5rem 0.6rem; border: 1px solid var(--color-border); border-radius: 6px; }
    .form-codigo input[name='codigo'] { text-transform: uppercase; width: 11rem; }
    .form-codigo input[name='porcentaje'] { width: 6rem; }
    .form-codigo .ancho { flex: 1; min-width: 12rem; }
    .boton-crear { background: var(--color-text); color: #fff; border: none; border-radius: 999px; padding: 0.6rem 1.25rem; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; cursor: pointer; }
    .ayuda { color: var(--color-muted); font-size: 0.85rem; margin: 0 0 1rem; }
    .codigo-inactivo td { color: var(--color-muted); }
    .inhabilitar { background: #fff; color: #b26a00; border: 1px solid #ecd2a8; }
    .reactivar { background: var(--color-text); color: #fff; border: 1px solid var(--color-text); }
    .boton-tabla:disabled { opacity: 0.5; cursor: wait; }
  </style>
</Base>
