---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import ProyectoLanding from '../../components/ProyectoLanding.astro';

const soluciones = [
  {
    nombre: 'Smart Homes y Domótica',
    descripcion: 'Sistemas cableados e inalámbricos que garantizan compatibilidad y personalización para cada proyecto.',
  },
  {
    nombre: 'Iluminación',
    descripcion: 'Soluciones cableadas e inalámbricas (IoT) diseñadas para una integración fluida, compatibles con KNX, Z-Wave, ZigBee, Bluetooth y Wi-Fi, además de protocolos propios.',
  },
  {
    nombre: 'Sonido',
    descripcion: 'Soluciones de audio de alta calidad para proyectos residenciales o comerciales.',
  },
  {
    nombre: 'Seguridad',
    descripcion: 'Sistemas avanzados y confiables que priorizan la protección sin comprometer la funcionalidad.',
  },
];

const caracteristicas = [
  {
    titulo: 'Compatibilidad Total',
    descripcion: 'Nuestras soluciones están diseñadas para integrarse con los principales sistemas y plataformas del mercado.',
  },
  {
    titulo: 'Calidad Garantizada',
    descripcion: 'Trabajamos con tecnología de vanguardia, asegurando durabilidad y rendimiento en cada instalación.',
  },
  {
    titulo: 'Flexibilidad en Implementación',
    descripcion: 'Adaptamos nuestros sistemas a las especificaciones y requerimientos de cada proyecto, sin complicaciones.',
  },
];
---
<Base title="Integradores PRO | AVCI Smart Homes" description="Soluciones KNX y domótica para integradores de sistemas: smart homes, iluminación, sonido y seguridad.">
  <ProyectoLanding
    eyebrow="Integradores de sistemas"
    headline="Tecnología que potencia tus proyectos"
    subtitle="Sabemos que como integrador de sistemas buscas soluciones confiables, fáciles de implementar y con la capacidad de adaptarse a proyectos de cualquier envergadura. Te ofrecemos herramientas que se integran sin complicaciones, respaldadas por innovación, calidad y compatibilidad con los principales estándares del sector."
    solucionesHeading="Soluciones diseñadas para integradores de sistemas"
    solucionesIntro="Nos convertimos en tu socio estratégico para garantizar el éxito de tus proyectos tecnológicos. Te ayudamos a integrar:"
    soluciones={soluciones}
    caracteristicasHeading="¿Por qué elegirnos como tu aliado?"
    caracteristicas={caracteristicas}
    imagen="https://keewlcnfppadsjmujlju.supabase.co/storage/v1/object/public/Fotos%20principales/4.png"
  />
</Base>
