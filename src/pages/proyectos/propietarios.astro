---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import ProyectoLanding from '../../components/ProyectoLanding.astro';

const soluciones = [
  {
    nombre: 'Smart Homes y Domótica',
    descripcion: 'Automatiza tu espacio y controla iluminación, temperatura y dispositivos desde tu móvil o por voz.',
  },
  {
    nombre: 'Iluminación',
    descripcion: 'Soluciones cableadas e inalámbricas (IoT) compatibles con KNX, Z-Wave, ZigBee, Bluetooth y Wi-Fi, además de protocolos propios. Diseños de luz que crean ambientes personalizados y optimizan el consumo energético.',
  },
  {
    nombre: 'Sonido',
    descripcion: 'Sistemas de audio envolventes y discretos, adaptados a cualquier espacio para una mejor experiencia.',
  },
  {
    nombre: 'Seguridad',
    descripcion: 'Cámaras, cerraduras inteligentes y sensores avanzados que protegen tu hogar o local y te ofrecen tranquilidad en todo momento.',
  },
];

const caracteristicas = [
  {
    titulo: 'Nos adaptamos a ti',
    descripcion: 'Te asesoramos para que elijas la mejor solución según las necesidades de tu vivienda o negocio.',
  },
  {
    titulo: 'Eficiencia',
    descripcion: 'Optimiza el consumo de energía y reduce costos sin renunciar al confort.',
  },
  {
    titulo: 'Seguridad y tranquilidad',
    descripcion: 'Controla y protege tu hogar o negocio desde cualquier lugar, con tecnología confiable.',
  },
];
---
<Base title="Propietarios | AVCI Smart Homes" description="Domótica para particulares: automatiza iluminación, sonido y seguridad de tu hogar o negocio.">
  <ProyectoLanding
    eyebrow="Domótica para particulares"
    headline="Vive la comodidad de un espacio inteligente"
    subtitle="Cada espacio tiene necesidades diferentes, y elegir la tecnología adecuada puede marcar la diferencia en comodidad, eficiencia y seguridad. Te ayudamos a encontrar la solución más conveniente para tu hogar o negocio, con sistemas inteligentes que se adaptan a tu estilo de vida y te ofrecen control total sobre tu entorno."
    solucionesHeading="Soluciones tecnológicas para tu hogar"
    solucionesIntro="Incorporamos tecnología intuitiva y fácil de usar para que disfrutes de un espacio más confortable, seguro y eficiente. Descubre cómo podemos transformar tu vivienda o negocio con:"
    soluciones={soluciones}
    caracteristicasHeading="¿Por qué elegirnos?"
    caracteristicas={caracteristicas}
    imagen="https://keewlcnfppadsjmujlju.supabase.co/storage/v1/object/public/Fotos%20principales/6.png"
  />
</Base>
