---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import ProyectoLanding from '../../components/ProyectoLanding.astro';

const soluciones = [
  {
    nombre: 'Smart Homes y Domótica',
    descripcion: 'Sistemas inteligentes que se ocultan en el diseño y mejoran la experiencia del usuario.',
  },
  {
    nombre: 'Iluminación',
    descripcion: 'Soluciones cableadas e inalámbricas (IoT) compatibles con KNX, Z-Wave, ZigBee, Bluetooth y Wi-Fi, además de protocolos propios. Diseños de luz que resaltan texturas, volúmenes y ambientes, creando espacios envolventes y funcionales.',
  },
  {
    nombre: 'Sonido',
    descripcion: 'Sistemas de audio de alta calidad e integración discreta, adaptados a cada concepto de diseño sin elementos invasivos.',
  },
  {
    nombre: 'Seguridad',
    descripcion: 'Soluciones avanzadas que combinan protección y estilo sin elementos invasivos.',
  },
];

const caracteristicas = [
  {
    titulo: 'Tecnología integrada sin impacto visual',
    descripcion: 'Soluciones diseñadas para integrarse a la perfección sin interferir en el concepto estético del proyecto.',
  },
  {
    titulo: 'Calidad y eficiencia garantizadas',
    descripcion: 'Sistemas de última generación que optimizan la funcionalidad del espacio sin perder elegancia.',
  },
  {
    titulo: 'Flexibilidad y personalización',
    descripcion: 'Te guiamos en la elección de los sistemas y materiales más adecuados para lograr el equilibrio perfecto entre funcionalidad y diseño.',
  },
];
---
<Base title="Diseñadores | AVCI Smart Homes" description="Tecnología que se integra de forma sutil en el diseño de interiores: domótica, iluminación, sonido y seguridad.">
  <ProyectoLanding
    eyebrow="Diseñadores de interior"
    headline="Tecnología que realza cada espacio"
    subtitle="Cada espacio cuenta una historia y cada detalle es clave en el resultado final. Sabemos que buscas soluciones que se integren de forma sutil en tus diseños sin alterar su esencia. Te ofrecemos tecnología innovadora que potencia la experiencia sensorial, garantizando estética, funcionalidad y personalización en cada proyecto."
    solucionesHeading="Soluciones tecnológicas para diseño de interiores"
    solucionesIntro="Nos especializamos en integrar tecnología de manera sutil y armoniosa para elevar la experiencia de cada espacio. Te ayudamos a incorporar:"
    soluciones={soluciones}
    caracteristicasHeading="¿Por qué elegirnos como tu aliado?"
    caracteristicas={caracteristicas}
  />
</Base>
