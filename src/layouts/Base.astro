---
import { tiendaMenu } from '../lib/categorias';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Tienda online de productos KNX para domótica.' } = Astro.props;

const proyectos = [
  { nombre: 'Integradores PRO', slug: 'integradores-pro' },
  { nombre: 'Diseñadores', slug: 'disenadores' },
  { nombre: 'Propietarios', slug: 'propietarios' },
  { nombre: 'Arquitectos', slug: 'arquitectos' },
  { nombre: 'Promotoras / Constructoras', slug: 'promotoras-constructoras' },
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <a href="/" class="logo">
      <img src="/logo-avci.png" alt="AVCI Smart Homes" />
    </a>
    <nav>
      <div class="nav-item has-dropdown">
        <button class="nav-trigger" aria-haspopup="true">Proyectos</button>
        <div class="mega-menu">
          {proyectos.map((p) => (
            <a href={`/proyectos/${p.slug}`}>{p.nombre}</a>
          ))}
        </div>
      </div>
      <div class="nav-item has-dropdown">
        <button class="nav-trigger" aria-haspopup="true">Tienda</button>
        <div class="mega-menu mega-menu--tienda">
          <div class="tienda-grid">
            {tiendaMenu.map((grupo) => (
              <div class="tienda-columna">
                <h3>{grupo.grupo}</h3>
                {grupo.categorias.length > 0 ? (
                  grupo.categorias.map((c) => (
                    <a href={`/productos?categoria=${c.slug}`}>{c.nombre}</a>
                  ))
                ) : (
                  <p class="vacio">Próximamente</p>
                )}
              </div>
            ))}
          </div>
          <a href="/productos" class="ver-todo-tienda">Ver todo el catálogo →</a>
        </div>
      </div>
      <a href="/contacto" class="nav-item">Contacto</a>
    </nav>
    <div class="header-icons">
      <a href="/contacto" class="icon-link" aria-label="Ayuda">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M9.5 9.5C9.5 8.11929 10.6193 7 12 7C13.3807 7 14.5 8.11929 14.5 9.5C14.5 10.8807 13.3807 11.6 12 12.5V13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="16.5" r="0.75" fill="currentColor"/></svg>
      </a>
      <div class="nav-item has-dropdown">
        <button class="icon-link nav-trigger" aria-haspopup="true" aria-label="Mi cuenta">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 12C14.4853 12 16.5 9.98528 16.5 7.5C16.5 5.01472 14.4853 3 12 3C9.51472 3 7.5 5.01472 7.5 7.5C7.5 9.98528 9.51472 12 12 12Z" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 20.5C4.94486 16.9942 8.19921 14.5 12 14.5C15.8008 14.5 19.0551 16.9942 20.5 20.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="mega-menu account-menu">
          <a href="/cuenta">Iniciar sesión</a>
          <a href="/registro">Registrarse</a>
        </div>
      </div>
      <a href="/carrito" class="icon-link cart-link" aria-label="Carrito">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 4H5L6.5 15.5H18.5L20 7H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="20" r="1.25" fill="currentColor"/><circle cx="17" cy="20" r="1.25" fill="currentColor"/></svg>
        <span class="cart-badge" id="cart-badge">0</span>
      </a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <img src="/logo-avci.png" alt="AVCI Smart Homes" class="footer-logo" />
    <p>&copy; {new Date().getFullYear()} AVCI Smart Homes. Todos los derechos reservados.</p>
  </footer>

  <script>
    const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
    const total = carrito.reduce((s: number, i: any) => s + (i.cantidad || 1), 0);
    const badge = document.getElementById('cart-badge');
    if (badge) badge.textContent = String(total);
  </script>

  <script>
    // El panel de "Tienda" está anclado a la ventana (position: fixed), separado
    // del botón que lo abre, así que el :hover de CSS se pierde si el ratón
    // cruza ese hueco en diagonal. Este margen de tolerancia evita que se cierre.
    document.querySelectorAll<HTMLElement>('.has-dropdown').forEach((item) => {
      let closeTimer: ReturnType<typeof setTimeout>;
      const menu = item.querySelector<HTMLElement>(':scope > .mega-menu');

      const open = () => {
        clearTimeout(closeTimer);
        item.classList.add('is-open');
      };
      const scheduleClose = () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => item.classList.remove('is-open'), 350);
      };

      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', scheduleClose);
      menu?.addEventListener('mouseenter', open);
      menu?.addEventListener('mouseleave', scheduleClose);
    });
  </script>

  <style is:global>
    :root {
      --color-bg: #ffffff;
      --color-text: #0a0a0a;
      --color-border: #e5e5e5;
      --color-muted: #6b6b6b;
      --color-primary: #2e6ef7;
      --color-primary-text: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      color: var(--color-text);
      background: var(--color-bg);
    }

    .site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      padding: 1.25rem 2.5rem;
      border-bottom: 1px solid var(--color-border);
      max-width: 1400px;
      margin: 0 auto;
      position: relative;
    }
    .logo img {
      height: 40px;
      display: block;
      /* el PNG es blanco sobre transparente: se invierte para verse en la cabecera clara */
      filter: invert(1);
    }

    .site-header nav {
      display: flex;
      align-items: center;
      gap: 2.5rem;
    }
    .nav-item {
      position: relative;
      text-decoration: none;
      color: var(--color-text);
      font-weight: 600;
      font-size: 1rem;
    }
    .nav-trigger {
      background: none;
      border: none;
      cursor: pointer;
      font: inherit;
      color: inherit;
      padding: 0.5rem 0;
      border-bottom: 2px solid transparent;
    }
    .nav-item:hover .nav-trigger,
    .nav-item.has-dropdown:hover > .nav-trigger,
    a.nav-item:hover {
      border-bottom-color: var(--color-primary);
    }

    .mega-menu {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 50%;
      background: #fff;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
      min-width: 240px;
      padding: 0.75rem 0;
      z-index: 20;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate(-50%, 8px);
      transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    }
    .has-dropdown:hover .mega-menu,
    .has-dropdown:focus-within .mega-menu,
    .has-dropdown.is-open .mega-menu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }
    .mega-menu a {
      text-decoration: none;
      color: var(--color-text);
      font-weight: 500;
      font-size: 0.9rem;
      padding: 0.75rem 1.5rem;
      white-space: nowrap;
      transition: background 0.15s ease;
    }
    .mega-menu a:hover { background: #f5f5f5; }
    .mega-menu .ver-todo { border-top: 1px solid var(--color-border); margin-top: 0.25rem; color: var(--color-muted); }
    .account-menu { right: 0; left: auto; min-width: 180px; transform: translateY(8px); }
    .has-dropdown:hover .account-menu,
    .has-dropdown:focus-within .account-menu,
    .has-dropdown.is-open .account-menu {
      transform: translateY(0);
    }

    /* Panel de "Tienda": a todo el ancho de la ventana, con columnas por grupo */
    .mega-menu.mega-menu--tienda {
      display: block;
      position: fixed;
      top: 81px;
      left: 0;
      right: 0;
      width: 100%;
      min-width: 0;
      padding: 2.5rem 2.5rem 2rem;
      transform: translateY(8px);
    }
    .has-dropdown:hover .mega-menu.mega-menu--tienda,
    .has-dropdown:focus-within .mega-menu.mega-menu--tienda,
    .has-dropdown.is-open .mega-menu.mega-menu--tienda {
      transform: translateY(0);
    }
    .tienda-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem 3rem;
      max-width: 1400px;
      margin: 0 auto;
    }
    .tienda-columna h3 {
      text-transform: uppercase;
      font-weight: 700;
      font-size: 0.95rem;
      margin: 0 0 0.75rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--color-border);
    }
    .mega-menu--tienda .tienda-columna a {
      display: block;
      padding: 0.4rem 0;
      white-space: normal;
    }
    .tienda-columna .vacio {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.85rem;
      font-style: italic;
    }
    .ver-todo-tienda {
      display: block;
      text-align: right;
      max-width: 1400px;
      margin: 2rem auto 0;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
      color: var(--color-muted);
      text-decoration: none;
      font-size: 0.85rem;
    }
    .ver-todo-tienda:hover { color: var(--color-primary); }

    .header-icons { display: flex; align-items: center; gap: 1.5rem; }
    .icon-link {
      position: relative;
      display: flex;
      color: var(--color-text);
      text-decoration: none;
    }
    .header-icons .nav-trigger.icon-link { padding: 0; border-bottom: none; }
    .cart-badge {
      position: absolute;
      top: -8px;
      right: -10px;
      background: var(--color-primary);
      color: var(--color-primary-text);
      font-size: 0.65rem;
      font-weight: 700;
      min-width: 16px;
      height: 16px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 3px;
    }

    main { max-width: 1400px; margin: 0 auto; }

    .site-footer {
      background: #000;
      color: #ccc;
      text-align: center;
      padding: 3rem 2rem;
      margin-top: 4rem;
    }
    .footer-logo { height: 40px; margin-bottom: 1rem; }
    .site-footer p { font-size: 0.85rem; margin: 0; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</body>
</html>