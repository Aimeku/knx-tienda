---
import { tiendaMenu } from '../lib/categorias';
import { getLangFromUrl, getSwitcherHref, useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Tienda online de productos KNX para domótica.' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const proyectos = [
  { key: 'proyectos.integradores', slug: 'integradores-pro' },
  { key: 'proyectos.disenadores', slug: 'disenadores' },
  { key: 'proyectos.propietarios', slug: 'propietarios' },
  { key: 'proyectos.arquitectos', slug: 'arquitectos' },
  { key: 'proyectos.promotoras', slug: 'promotoras-constructoras' },
] as const;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <a href={lang === 'en' ? '/en' : '/'} class="logo">
      <img src="/logo-avci.png" alt="AVCI Smart Homes" />
    </a>
    <nav>
      <div class="nav-item has-dropdown">
        <button class="nav-trigger" aria-haspopup="true">{t('nav.proyectos')}</button>
        <div class="mega-menu">
          {proyectos.map((p) => (
            <a href={lang === 'en' ? `/en/proyectos/${p.slug}` : `/proyectos/${p.slug}`}>{t(p.key)}</a>
          ))}
        </div>
      </div>
      <div class="nav-item has-dropdown">
        <button class="nav-trigger" aria-haspopup="true">{t('nav.tienda')}</button>
        <div class="mega-menu mega-menu--tienda">
          <div class="tienda-grid">
            {tiendaMenu.map((grupo) => (
              <div class="tienda-columna">
                <h3>{grupo.grupo}</h3>
                {grupo.categorias.length > 0 ? (
                  grupo.categorias.map((c) => (
                    <a href={`/productos?categoria=${c.slug}`}>{c.nombre}</a>
                  ))
                ) : (
                  <p class="vacio">{t('nav.proximamente')}</p>
                )}
              </div>
            ))}
          </div>
          <a href="/productos" class="ver-todo-tienda">{t('nav.verTodoCatalogo')}</a>
        </div>
      </div>
      <a href={lang === 'en' ? '/en/contacto' : '/contacto'} class="nav-item">{t('nav.contacto')}</a>
    </nav>
    <div class="header-icons">
      <div class="lang-switch">
        <a href={getSwitcherHref(Astro.url.pathname, 'es')} class={lang === 'es' ? 'is-active' : ''}>ES</a>
        <span aria-hidden="true">|</span>
        <a href={getSwitcherHref(Astro.url.pathname, 'en')} class={lang === 'en' ? 'is-active' : ''}>EN</a>
      </div>
      <a href="/cuenta" class="icon-link" aria-label={t('nav.cuenta')}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 12C14.4853 12 16.5 9.98528 16.5 7.5C16.5 5.01472 14.4853 3 12 3C9.51472 3 7.5 5.01472 7.5 7.5C7.5 9.98528 9.51472 12 12 12Z" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 20.5C4.94486 16.9942 8.19921 14.5 12 14.5C15.8008 14.5 19.0551 16.9942 20.5 20.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
      <a href="/carrito" class="icon-link cart-link" aria-label={t('nav.carrito')}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 4H5L6.5 15.5H18.5L20 7H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="20" r="1.25" fill="currentColor"/><circle cx="17" cy="20" r="1.25" fill="currentColor"/></svg>
        <span class="cart-badge" id="cart-badge">0</span>
      </a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={lang === 'en' ? '/en' : '/'}><img src="/logo-avci.png" alt="AVCI Smart Homes" class="footer-logo" /></a>
        <a href="https://www.instagram.com/avci.smarthomes/" target="_blank" rel="noopener" class="footer-social" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
      </div>

      <div class="footer-col">
        <h3>{t('footer.proyectos')}</h3>
        <a href="/productos">{t('footer.tienda')}</a>
        {proyectos.slice().reverse().map((p) => (
          <a href={lang === 'en' ? `/en/proyectos/${p.slug}` : `/proyectos/${p.slug}`}>{t(p.key)}</a>
        ))}
      </div>

      <div class="footer-col">
        <h3>{t('footer.enlaces')}</h3>
        <a href={lang === 'en' ? '/en/contacto' : '/contacto'}>{t('footer.contacto')}</a>
        <a href="/cuenta">{t('footer.miCuenta')}</a>
        <a href="mailto:info@avci.es" class="footer-contact">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M4 6.5L12 13L20 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          info@avci.es
        </a>
        <a href="tel:+34639701521" class="footer-contact">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4.5 4H8.5L10.5 9L8 10.5C9 13 11 15 13.5 16L15 13.5L20 15.5V19.5C20 20.6 19.1 21.4 18 21.2C10.5 19.8 4.7 14 3.3 6.5C3.1 5.4 3.9 4 4.5 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          639 701 521
        </a>
        <a href="tel:+34648443012" class="footer-contact">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4.5 4H8.5L10.5 9L8 10.5C9 13 11 15 13.5 16L15 13.5L20 15.5V19.5C20 20.6 19.1 21.4 18 21.2C10.5 19.8 4.7 14 3.3 6.5C3.1 5.4 3.9 4 4.5 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          648 443 012
        </a>
      </div>

      <div class="footer-col footer-newsletter">
        <h3>{t('footer.newsletter')}</h3>
        <form id="newsletter-form">
          <input type="email" name="email" placeholder={t('footer.emailPlaceholder')} aria-label={t('footer.emailPlaceholder')} required />
          <label class="footer-checkbox">
            <input type="checkbox" name="privacidad" required />
            {t('footer.privacidadPre')} <a href="/privacidad">{t('footer.privacidadLink')}</a>
          </label>
          <p class="footer-newsletter-ok" hidden>{t('footer.graciasSuscribirte')}</p>
          <button type="submit">{t('footer.enviar')}</button>
        </form>
      </div>
    </div>

    <div class="footer-addresses">
      <p>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 21C12 21 19 14.5 19 9.5C19 5.36 15.64 2 12 2C8.36 2 5 5.36 5 9.5C5 14.5 12 21 12 21Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
        Centro Comercial, Av. Petunias, 32, Local 3, San Pedro de Alcántara (Málaga)
      </p>
      <p>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 21C12 21 19 14.5 19 9.5C19 5.36 15.64 2 12 2C8.36 2 5 5.36 5 9.5C5 14.5 12 21 12 21Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
        C/de Ángel Múgica, 4, Fuencarral-El Pardo, Madrid
      </p>
    </div>

    <hr class="footer-divider" />

    <div class="footer-legal">
      <a href="/aviso-legal">{t('footer.avisoLegal')}</a>
      <a href="/privacidad">{t('footer.politicaPrivacidad')}</a>
      <a href="/cookies">{t('footer.politicaCookies')}</a>
      <a href="/condiciones-generales-compra">{t('footer.condicionesCompra')}</a>
    </div>

    <p class="footer-copy">&copy; {new Date().getFullYear()}. AVCI. {t('footer.derechos')}</p>
  </footer>

  <script>
    const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
    const total = carrito.reduce((s: number, i: any) => s + (i.cantidad || 1), 0);
    const badge = document.getElementById('cart-badge');
    if (badge) badge.textContent = String(total);
  </script>

  <script>
    // Newsletter: solo la interfaz por ahora, sin conectar a ningún servicio de envío.
    const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
    newsletterForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const ok = newsletterForm.querySelector('.footer-newsletter-ok') as HTMLElement | null;
      if (ok) ok.hidden = false;
      newsletterForm.reset();
    });
  </script>

  <script>
    // El panel de "Tienda" está anclado a la ventana (position: fixed), separado
    // del botón que lo abre, así que el :hover de CSS se pierde si el ratón
    // cruza ese hueco en diagonal. Este margen de tolerancia evita que se cierre.
    document.querySelectorAll<HTMLElement>('.has-dropdown').forEach((item) => {
      let closeTimer: ReturnType<typeof setTimeout>;
      const menu = item.querySelector<HTMLElement>(':scope > .mega-menu');

      const open = () => {
        clearTimeout(closeTimer);
        item.classList.add('is-open');
      };
      const scheduleClose = () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => item.classList.remove('is-open'), 350);
      };

      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', scheduleClose);
      menu?.addEventListener('mouseenter', open);
      menu?.addEventListener('mouseleave', scheduleClose);
    });
  </script>

  <style is:global>
    :root {
      --color-bg: #ffffff;
      --color-text: #0a0a0a;
      --color-border: #e5e5e5;
      --color-muted: #6b6b6b;
      --color-primary: #0a0a0a;
      --color-primary-text: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      overflow-x: hidden;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      color: var(--color-text);
      background: var(--color-bg);
    }

    .site-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
      padding: 1.25rem 2.5rem;
      border-bottom: 1px solid var(--color-border);
      max-width: 1400px;
      margin: 0 auto;
      position: sticky;
      top: 0;
      z-index: 50;
      background: #fff;
    }
    .site-header .logo { justify-self: start; }
    .site-header .header-icons { justify-self: end; }
    .logo img {
      height: 40px;
      display: block;
      /* el PNG es blanco sobre transparente: se invierte para verse en la cabecera clara */
      filter: invert(1);
    }

    .site-header nav {
      display: flex;
      align-items: center;
      gap: 2.5rem;
    }
    .nav-item {
      position: relative;
      text-decoration: none;
      color: var(--color-text);
      font-weight: 600;
      font-size: 1rem;
    }
    .nav-trigger {
      background: none;
      border: none;
      cursor: pointer;
      font: inherit;
      color: inherit;
      padding: 0.5rem 0;
      border-bottom: 2px solid transparent;
    }
    .nav-item:hover .nav-trigger,
    .nav-item.has-dropdown:hover > .nav-trigger,
    a.nav-item:hover {
      border-bottom-color: var(--color-primary);
    }

    .mega-menu {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 50%;
      background: #fff;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
      min-width: 240px;
      padding: 0.75rem 0;
      z-index: 20;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate(-50%, 8px);
      transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    }
    .has-dropdown:hover .mega-menu,
    .has-dropdown:focus-within .mega-menu,
    .has-dropdown.is-open .mega-menu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }
    .mega-menu a {
      text-decoration: none;
      color: var(--color-text);
      font-weight: 500;
      font-size: 0.9rem;
      padding: 0.75rem 1.5rem;
      white-space: nowrap;
      transition: background 0.15s ease;
    }
    .mega-menu a:hover { background: #f5f5f5; }
    .mega-menu .ver-todo { border-top: 1px solid var(--color-border); margin-top: 0.25rem; color: var(--color-muted); }

    /* Panel de "Tienda": a todo el ancho de la ventana, con columnas por grupo */
    .mega-menu.mega-menu--tienda {
      display: block;
      position: fixed;
      top: 81px;
      left: 0;
      right: 0;
      width: 100%;
      min-width: 0;
      padding: 2.5rem 2.5rem 2rem;
      transform: translateY(8px);
    }
    .has-dropdown:hover .mega-menu.mega-menu--tienda,
    .has-dropdown:focus-within .mega-menu.mega-menu--tienda,
    .has-dropdown.is-open .mega-menu.mega-menu--tienda {
      transform: translateY(0);
    }
    .tienda-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem 3rem;
      max-width: 1400px;
      margin: 0 auto;
    }
    .tienda-columna h3 {
      text-transform: uppercase;
      font-weight: 700;
      font-size: 0.95rem;
      margin: 0 0 0.75rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--color-border);
    }
    .mega-menu--tienda .tienda-columna a {
      display: block;
      padding: 0.4rem 0;
      white-space: normal;
    }
    .tienda-columna .vacio {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.85rem;
      font-style: italic;
    }
    .ver-todo-tienda {
      display: block;
      text-align: right;
      max-width: 1400px;
      margin: 2rem auto 0;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
      color: var(--color-muted);
      text-decoration: none;
      font-size: 0.85rem;
    }
    .ver-todo-tienda:hover { color: var(--color-primary); }

    .header-icons { display: flex; align-items: center; gap: 1.5rem; }
    .icon-link {
      position: relative;
      display: flex;
      color: var(--color-text);
      text-decoration: none;
    }
    .header-icons .nav-trigger.icon-link { padding: 0; border-bottom: none; }
    .lang-switch {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-muted);
    }
    .lang-switch a { color: inherit; text-decoration: none; }
    .lang-switch a.is-active { color: var(--color-text); }
    .lang-switch span { color: var(--color-border); }
    .cart-badge {
      position: absolute;
      top: -8px;
      right: -10px;
      background: var(--color-primary);
      color: var(--color-primary-text);
      font-size: 0.65rem;
      font-weight: 700;
      min-width: 16px;
      height: 16px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 3px;
    }

    main { max-width: 1400px; margin: 0 auto; }

    .site-footer {
      background: #000;
      color: #ccc;
      padding: 3.5rem 2.5rem 2rem;
      margin-top: 4rem;
    }
    .footer-top {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.3fr 1fr 1fr 1.3fr;
      gap: 2.5rem;
      padding-bottom: 2.5rem;
    }
    @media (max-width: 900px) {
      .footer-top { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px) {
      .footer-top { grid-template-columns: 1fr; }
    }

    .footer-brand { display: flex; flex-direction: column; gap: 1.25rem; }
    .footer-logo { height: 44px; filter: invert(1); }
    .footer-social {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 999px;
      background: #fff;
      color: #000;
    }

    .footer-col h3 { color: #fff; font-size: 1.05rem; margin: 0 0 1.1rem; }
    .footer-col { display: flex; flex-direction: column; }
    .footer-col a {
      color: #ccc;
      text-decoration: none;
      font-size: 0.9rem;
      padding: 0.3rem 0;
    }
    .footer-col a:hover { color: #fff; }
    .footer-contact { display: flex; align-items: center; gap: 0.5rem; }

    .footer-newsletter form { display: flex; flex-direction: column; gap: 0.9rem; }
    .footer-newsletter input[type='email'] {
      padding: 0.8rem 1.1rem;
      border-radius: 999px;
      border: 1px solid #444;
      background: transparent;
      color: #fff;
      font: inherit;
    }
    .footer-newsletter input[type='email']::placeholder { color: #888; }
    .footer-checkbox {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: #999;
      padding: 0;
    }
    .footer-checkbox input { accent-color: var(--color-primary); margin-top: 0.2rem; }
    .footer-checkbox a { color: #ccc; padding: 0; display: inline; }
    .footer-newsletter-ok { color: #7fd88a; font-size: 0.85rem; margin: 0; }
    .footer-newsletter button {
      background: #fff;
      color: #000;
      border: none;
      border-radius: 999px;
      padding: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      font-size: 0.9rem;
    }

    .footer-addresses {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 3rem;
      font-size: 0.85rem;
      color: #ccc;
    }
    .footer-addresses p { display: flex; align-items: center; gap: 0.5rem; margin: 0; }

    .footer-divider {
      max-width: 1400px;
      margin: 2rem auto;
      border: none;
      border-top: 1px solid #333;
    }

    .footer-legal {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 2rem;
      margin-bottom: 1.5rem;
    }
    .footer-legal a { color: #ccc; text-decoration: none; font-size: 0.85rem; }
    .footer-legal a:hover { color: #fff; }

    .footer-copy { text-align: center; font-size: 0.85rem; font-weight: 700; margin: 0; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</body>
</html>