---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Tienda online de productos KNX para domótica.' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <div class="top-bar">
    <div class="top-bar-inner">
      <a href="/cuenta">Iniciar Sesión</a>
      <span class="divider">|</span>
      <a href="/registro">Registrarse</a>
    </div>
  </div>

  <header class="site-header">
    <a href="/" class="logo">
      <img src="/logo-avci.png" alt="AVCI Smart Homes" />
    </a>
    <nav>
      <a href="/productos">Tienda</a>
      <a href="/contacto">Contacto</a>
    </nav>
    <div class="header-icons">
      <a href="/carrito" class="cart-link">Carrito</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <img src="/logo-avci.png" alt="AVCI Smart Homes" class="footer-logo" />
    <p>&copy; {new Date().getFullYear()} AVCI Smart Homes. Todos los derechos reservados.</p>
  </footer>

  <style is:global>
    :root {
      --color-bg: #ffffff;
      --color-text: #0a0a0a;
      --color-border: #e5e5e5;
      --color-muted: #6b6b6b;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      color: var(--color-text);
      background: var(--color-bg);
    }
    .top-bar {
      background: #000;
      color: #fff;
      font-size: 0.8rem;
    }
    .top-bar-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0.5rem 2rem;
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
    }
    .top-bar a { color: #fff; text-decoration: none; }
    .top-bar .divider { opacity: 0.4; }

    .site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      border-bottom: 1px solid var(--color-border);
      max-width: 1400px;
      margin: 0 auto;
    }
    .logo img { height: 48px; display: block; }
    .site-header nav { display: flex; gap: 2rem; }
    .site-header nav a {
      text-decoration: none;
      color: var(--color-text);
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      font-size: 0.9rem;
    }
    .cart-link {
      text-decoration: none;
      color: var(--color-text);
      font-weight: 600;
      font-size: 0.9rem;
    }

    main { max-width: 1400px; margin: 0 auto; }

    .site-footer {
      background: #000;
      color: #ccc;
      text-align: center;
      padding: 3rem 2rem;
      margin-top: 4rem;
    }
    .footer-logo { height: 40px; margin-bottom: 1rem; filter: invert(1); }
    .site-footer p { font-size: 0.85rem; margin: 0; }
  </style>
</body>
</html>