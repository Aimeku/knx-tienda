# Supabase (Project Settings > API)
PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Pago por transferencia: datos que se muestran al cliente al confirmar el pedido.
TRANSFERENCIA_IBAN=ES00 0000 0000 0000 0000 0000
TRANSFERENCIA_TITULAR=Nombre del titular de la cuenta
TRANSFERENCIA_BANCO=Nombre del banco (opcional)

# Resend (resend.com > API Keys) — avisos de solicitud de cuenta y aprobación.
# Requiere verificar el dominio avci.es en Resend para poder enviar a terceros.
RESEND_API_KEY=re_...
